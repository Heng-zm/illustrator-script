            "Batch export complete!\n": "\u1780\u17b6\u179a\u1793\u17b6\u17c6\u1785\u17c1\u1789\u1794\u17b6\u1793\u1787\u17c4\u1782\u1787\u17d0\u1799!\n",
            "file(s) exported across": "\u17af\u1780\u179f\u17b6\u179a\u178f\u17d2\u179a\u17bc\u179c\u1794\u17b6\u1793\u1793\u17b6\u17c6\u1785\u17c1\u1789\u179b\u17be",
            "artboard(s) to:\n": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u1791\u17c5\u1780\u17b6\u1793\u17cb\u17d6\n",
            "Please select at least one format to export.": "\u179f\u17bc\u1798\u1787\u17d2\u179a\u17be\u179f\u1791\u1798\u17d2\u179a\u1784\u17cb\u1799\u17c9\u17c4\u1784\u17a0\u17c4\u1785\u178e\u17b6\u179f\u17cb\u1798\u17bd\u1799\u17d4",
            "Transparent": "\u1795\u17d2\u1791\u17c3\u1790\u17d2\u179b\u17b6 (Transparent)",
            "Single combined multi-page PDF": "\u17af\u1780\u179f\u17b6\u179a PDF \u179a\u17bd\u1798\u178f\u17c2\u1798\u17bd\u1799 (\u1785\u17d2\u179a\u17be\u1793\u1791\u17c6\u1796\u17d0\u179a)",
            "Separate files per artboard": "\u1794\u17c2\u1784\u1785\u17c2\u1780\u17af\u1780\u179f\u17b6\u179a\u178f\u17b6\u1798\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a",
            "Convert text to outlines before export": "\u1794\u17c6\u1794\u17c2\u1780\u17a2\u1780\u17d2\u179f\u179a\u1787\u17b6 Outline \u1798\u17bb\u1793\u1793\u17b6\u17c6\u1785\u17c1\u1789",
            "Prepress Options": "\u1787\u1798\u17d2\u179a\u17be\u179f\u1798\u17bb\u1793\u1794\u17c4\u17c7\u1796\u17bb\u1798\u17d2\u1796 (Prepress)",
            "Multi-page": "\u1785\u17d2\u179a\u17be\u1793\u1791\u17c6\u1796\u17d0\u179a (Multi-page)",
            "Separate": "\u178a\u17b6\u1785\u17cb\u178a\u17c4\u1799\u17a1\u17c2\u1780",
            "Click to insert ": "\u1785\u17bb\u1785\u178a\u17be\u1798\u17d2\u1794\u17b8\u1794\u1789\u17d2\u1785\u17bc\u179b ",
            "Multi-page PDF containing all selected artboards": "\u17af\u1780\u179f\u17b6\u179a PDF \u179a\u17bd\u1798\u178f\u17c2\u1798\u17bd\u1799\u1795\u17d2\u1791\u17bb\u1780\u1782\u17d2\u179a\u1794\u17cb\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u178a\u17c2\u179b\u1794\u17b6\u1793\u1787\u17d2\u179a\u17be\u179f",
            "Range:": "\u1785\u1793\u17d2\u179b\u17c4\u17c7\u17d6",
            "Browse...": "\u179a\u1780\u1798\u17be\u179b...",
            "Select Destination Folder": "\u1787\u17d2\u179a\u17be\u179f\u1790\u178f\u178a\u17c6\u178e\u17c4\u1784\u1785\u17bb\u1784\u1780\u17d2\u179a\u17c4\u1799",
            "Please choose a destination folder.": "\u179f\u17bc\u1798\u1787\u17d2\u179a\u17be\u179f\u1790\u178f\u178a\u17c6\u178e\u17c4\u1784\u1785\u17bb\u1784\u1780\u17d2\u179a\u17c4\u1799\u17d4",
            "Could not create destination folder:\n": "\u1798\u17b7\u1793\u17a2\u17b6\u1785\u1794\u1784\u17d2\u1780\u17be\u178f\u1790\u178f\u1794\u17b6\u1793\u1791\u17c1\u17d6\n",
            "Invalid destination folder:\n": "\u1790\u178f\u1798\u17b7\u1793\u178f\u17d2\u179a\u17b9\u1798\u178f\u17d2\u179a\u17c7\u17d6\n",
            "Please enter a valid subfolder name.": "\u179f\u17bc\u1798\u1794\u1789\u17d2\u1785\u17bc\u179b\u1788\u17d2\u1798\u17c4\u17c7\u1790\u178f\u179a\u1784\u17d2\u179c\u17c4\u1784\u178f\u17d2\u179a\u17b9\u1798\u178f\u17d2\u179a\u17c7\u17d4",
            "Please specify a valid artboard range (e.g. 1, 3-5).": "\u179f\u17bc\u1798\u1780\u17c6\u178e\u178f\u17cb\u1785\u1793\u17d2\u179b\u17c4\u17c7\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u17b2\u17d2\u1799\u178f\u17d2\u179a\u17b9\u1798\u178f\u17d2\u179a\u17c7 (\u17a7\u1791\u17b6. 1, 3-5)\u17d4",
            "PDF export and text outlining temporarily modify the document.\n\nSave the document before continuing?": "\u1780\u17b6\u179a\u1793\u17b6\u17c6\u1785\u17c1\u1789 PDF \u1793\u17b7\u1784\u1794\u17c6\u1794\u17c2\u1780 Outline \u1793\u17b9\u1784\u1780\u17c2\u1794\u17d2\u179a\u17c2\u17af\u1780\u179f\u17b6\u179a\u1794\u178e\u17d2\u178a\u17c4\u17c7\u17a2\u179f\u1793\u17d2\u1793\u17d4\n\n\u178f\u17be\u17a2\u17d2\u1793\u1780\u1785\u1784\u17cb\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u17af\u1780\u179f\u17b6\u179a\u1798\u17bb\u1793\u1796\u17c1\u179b\u1794\u1793\u17d2\u178f\u178a\u17c2\u179a\u17ac\u1791\u17c1?",
            "Save Illustrator Document As": "\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u17af\u1780\u179f\u17b6\u179a Illustrator \u1787\u17b6",
            "Failed to save document:\n": "\u1798\u17b7\u1793\u17a2\u17b6\u1785\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u17af\u1780\u179f\u17b6\u179a\u1794\u17b6\u1793\u1791\u17c1\u17d6\n",
            "Export cancelled. Save the document and try again.": "\u1780\u17b6\u179a\u1793\u17b6\u17c6\u1785\u17c1\u1789\u178f\u17d2\u179a\u17bc\u179c\u1794\u17b6\u1793\u1794\u17c4\u17c7\u1794\u1784\u17cb\u17d4 \u179f\u17bc\u1798\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u17af\u1780\u179f\u17b6\u179a \u17a0\u17be\u1799\u179f\u17b6\u1780\u179b\u17d2\u1794\u1784\u1798\u17d2\u178f\u1784\u1791\u17c0\u178f\u17d4",
            "The document must be saved before exporting PDF or outlining text.": "\u17af\u1780\u179f\u17b6\u179a\u178f\u17d2\u179a\u17bc\u179c\u178f\u17c2\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u1798\u17bb\u1793\u1796\u17c1\u179b\u1793\u17b6\u17c6\u1785\u17c1\u1789 PDF \u17ac\u1794\u17c6\u1794\u17c2\u1780 Outline\u17d4",
            "This document is not a saved .ai file. Save it as an .ai file before exporting PDF or outlining text.": "\u17af\u1780\u179f\u17b6\u179a\u1793\u17c1\u17c7\u1798\u17b7\u1793\u1798\u17c2\u1793\u1787\u17b6\u17af\u1780\u179f\u17b6\u179a .ai \u178a\u17c2\u179b\u1794\u17b6\u1793\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u1791\u17c1\u17d4 \u179f\u17bc\u1798\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u1787\u17b6 .ai \u1798\u17bb\u1793\u1796\u17c1\u179b\u1793\u17b6\u17c6\u1785\u17c1\u1789 PDF \u17ac\u1794\u17c6\u1794\u17c2\u1780 Outline\u17d4",
            "PDF export and text outlining temporarily modify the document.\n\nSave your latest changes before continuing?": "\u1780\u17b6\u179a\u1793\u17b6\u17c6\u1785\u17c1\u1789 PDF \u1793\u17b7\u1784\u1794\u17c6\u1794\u17c2\u1780 Outline \u1793\u17b9\u1784\u1780\u17c2\u1794\u17d2\u179a\u17c2\u17af\u1780\u179f\u17b6\u179a\u1794\u178e\u17d2\u178a\u17c4\u17c7\u17a2\u179f\u1793\u17d2\u1793\u17d4\n\n\u178f\u17be\u17a2\u17d2\u1793\u1780\u1785\u1784\u17cb\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u1780\u17b6\u179a\u1795\u17d2\u179b\u17b6\u179f\u17cb\u1794\u17d2\u178f\u17bc\u179a\u1785\u17bb\u1784\u1780\u17d2\u179a\u17c4\u1799\u1798\u17bb\u1793\u1796\u17c1\u179b\u1794\u1793\u17d2\u178f\u178a\u17c2\u179a\u17ac\u1791\u17c1?",
            "Could not determine the document path. Save the document and try again.": "\u1798\u17b7\u1793\u17a2\u17b6\u1785\u1780\u17c6\u178e\u178f\u17cb\u1795\u17d2\u179b\u17bc\u179c\u17af\u1780\u179f\u17b6\u179a\u1794\u17b6\u1793\u1791\u17c1\u17d4 \u179f\u17bc\u1798\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u17af\u1780\u179f\u17b6\u179a \u17a0\u17be\u1799\u179f\u17b6\u1780\u179b\u17d2\u1794\u1784\u1798\u17d2\u178f\u1784\u1791\u17c0\u178f\u17d4",
            "Notes / Errors:": "\u1780\u17c6\u178e\u178f\u17cb\u179f\u1798\u17d2\u1782\u17b6\u17b4 / \u1780\u17c6\u17a0\u17bb\u179f\u17d6",
            "Planned output:": "\u1782\u17d2\u179a\u17c4\u1784\u1793\u17b6\u17c6\u1785\u17c1\u1789\u17d6",
            "artboard(s)": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a",
            "format(s)": "\u1791\u1798\u17d2\u179a\u1784\u17cb",
            "file(s) total": "\u17af\u1780\u179f\u17b6\u179a\u179f\u179a\u17bb\u1794",
            "Please select at least one format.": "\u179f\u17bc\u1798\u1787\u17d2\u179a\u17be\u179f\u1791\u1798\u17d2\u179a\u1784\u17cb\u1799\u17c7\u17a0\u17c4\u1785\u178e\u17b6\u179f\u17cb\u1798\u17bd\u1799\u17d4",

            "CutContour / Die-Line Generator PRO": "\u1780\u1798\u17d2\u1798\u179c\u17b7\u1792\u17b8\u1794\u1784\u17d2\u1780\u17be\u178f\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb CutContour PRO",
            "Install Ozo Tools Plugin": "\u178a\u17c6\u178e\u17be\u1784\u1780\u1798\u17d2\u1798\u179c\u17b7\u1792\u17b8\u1794\u1793\u17d2\u1790\u17c2\u1798 Ozo Tools",
            "Install Ozo Tools for Adobe Illustrator": "\u178a\u17c6\u178e\u17be\u1784 Ozo Tools \u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb Adobe Illustrator",
            "Transforms all scripts into a native dockable panel and menu plugin.": "\u1794\u1798\u17d2\u179b\u17c2\u1784\u179f\u17d2\u1782\u17d2\u179a\u17b8\u1794\u1791\u17b6\u17c6\u1784\u17a2\u179f\u17cb\u1787\u17b6\u1795\u17d2\u1791\u17b6\u17c6\u1784 Dockable \u1793\u17b7\u1784\u1798\u17c9\u17c1\u1793\u17bb\u1799\u1795\u17d2\u179b\u17bc\u179c\u1780\u17b6\u179a\u17d4",
            "Installation Options": "\u1787\u1798\u17d2\u179a\u17be\u179f\u178a\u17c6\u178e\u17be\u1784",
            "Install Dockable Panel Plugin (Window > Extensions > Ozo Tools)": "\u178a\u17c6\u178e\u17be\u1784\u1795\u17d2\u1791\u17b6\u17c6\u1784 Dockable (Window > Extensions > Ozo Tools)",
            "Install Native Menu Items (File > Scripts > Ozo Tools)": "\u178a\u17c6\u178e\u17be\u1784\u1798\u17c9\u17c1\u1793\u17bb\u1799\u179f\u17d2\u1782\u17d2\u179a\u17b8\u1794 (File > Scripts > Ozo Tools)",
            "Enable Adobe Extension Developer Mode (PlayerDebugMode)": "\u1794\u17be\u1780 Developer Mode (PlayerDebugMode)",
            "Install Now": "\u178a\u17c6\u178e\u17be\u1784\u17a2\u17c2\u179b\u17c4\u179c\u1793\u17c1\u17c7"
        };

        function prefFile() {
            var folder = new Folder(Folder.userData.fsName + "/Ozo Illustrator Scripts");
            if (!folder.exists) try { folder.create(); } catch (ignore) {}
            if (!folder.exists) {
                folder = new Folder(Folder.temp.fsName + "/Ozo Illustrator Scripts");
                if (!folder.exists) try { folder.create(); } catch (ignore) {}
            }
            return new File(folder.fsName + "/preferences.ini");
        }

        function readAll() {
            if (cache !== null) return cache;
            cache = {};
            var file = prefFile();
            if (!file.exists) return cache;
            try {
                file.encoding = "UTF-8";
                if (!file.open("r")) return cache;
                var content = file.read();
                file.close();
                var lines = content.split(/\r?\n/);
                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i];
                    var split = line.indexOf("\t");
                    if (split < 1) continue;
                    try {
                        cache[decodeURIComponent(line.substring(0, split))] =
                            decodeURIComponent(line.substring(split + 1));
                    } catch (ignoreLine) {}
                }
            } catch (ignoreRead) { try { file.close(); } catch (ignoreClose) {} }
            return cache;
        }

        function writeAll() {
            var data = readAll(), keys = [], key, file = prefFile();
            for (key in data) if (data.hasOwnProperty(key)) keys.push(key);
            keys.sort();
            try {
                file.encoding = "UTF-8";
                file.lineFeed = "Unix";
                if (!file.open("w")) return false;
                var buffer = [];
                for (var i = 0; i < keys.length; i++) {
                    buffer.push(encodeURIComponent(keys[i]) + "\t" +
                        encodeURIComponent(String(data[keys[i]])));
                }
                file.write(buffer.join("\n") + "\n");
                file.close();
                return true;
            } catch (ignoreWrite) { try { file.close(); } catch (ignoreClose) {} }
            return false;
        }

        function getValue(namespace, key, fallback) {
            var data = readAll(), full = namespace + "." + key;
            return data.hasOwnProperty(full) ? data[full] : fallback;
        }

        function setValue(namespace, key, value) {
            readAll()[namespace + "." + key] = String(value);
            return writeAll();
        }

        function visit(parent, callback, path) {
            path = path || "";
            if (!parent || !parent.children) return;
            for (var i = 0; i < parent.children.length; i++) {
                var child = parent.children[i], childPath = path ? path + "." + i : String(i);
                callback(child, childPath);
                visit(child, callback, childPath);
            }
        }

        function saveWindowState(windowObject, namespace, extraValues) {
            var data = readAll();
            visit(windowObject, function (control, path) {
                var key = namespace + ".control." + path + "." + control.type;
                if (control._ozoNoSave) {
                    if (data.hasOwnProperty(key)) delete data[key];
                    return;
                }
                var value;
                if (control.type === "edittext") value = control.text;
                else if (control.type === "checkbox" || control.type === "radiobutton") value = control.value ? "1" : "0";
                else if (control.type === "dropdownlist" && control.selection) value = String(control.selection.index);
                else return;
                data[key] = value;
            });
            if (extraValues) {
                for (var extraKey in extraValues) {
                    if (extraValues.hasOwnProperty(extraKey)) {
                        data[namespace + "." + extraKey] = String(extraValues[extraKey]);
                    }
                }
            }
            return writeAll();
        }

        function restoreWindowState(windowObject, namespace) {
            var data = readAll();
            visit(windowObject, function (control, path) {
                if (control._ozoNoSave) return;
                var key = namespace + ".control." + path + "." + control.type;
                if (!data.hasOwnProperty(key)) return;
                try {
                    if (control.type === "edittext") control.text = data[key];
                    else if (control.type === "checkbox" || control.type === "radiobutton") control.value = data[key] === "1";
                    else if (control.type === "dropdownlist") {
                        var index = Number(data[key]);
                        if (index >= 0 && index < control.items.length) control.selection = index;
                    }
                } catch (ignoreRestore) {}
            });
        }

        function language() { return getValue("global", "language", "en") === "km" ? "km" : "en"; }
        function tr(text) { return language() === "km" && km.hasOwnProperty(text) ? km[text] : text; }

        function localize(control) {
            if (!control || control._ozoSkipTranslate) return;
            try {
                if (typeof control.text === "string" && control.type !== "edittext" && control.type !== "listbox") {
                    if (typeof control._ozoEnglishText === "undefined") control._ozoEnglishText = control.text;
                    control.text = language() === "km" && km.hasOwnProperty(control._ozoEnglishText) ?
                        km[control._ozoEnglishText] : control._ozoEnglishText;
                }
                if (control.type === "dropdownlist") {
                    if (!control._ozoEnglishItems) {
                        control._ozoEnglishItems = [];
                        for (var i = 0; i < control.items.length; i++) control._ozoEnglishItems.push(control.items[i].text);
                    }
                    for (i = 0; i < control.items.length && i < control._ozoEnglishItems.length; i++) {
                        control.items[i].text = language() === "km" && km.hasOwnProperty(control._ozoEnglishItems[i]) ?
                            km[control._ozoEnglishItems[i]] : control._ozoEnglishItems[i];
                    }
                }
            } catch (ignoreTranslation) {}
        }

        function translateWindow(windowObject) {
            localize(windowObject);
            visit(windowObject, function (control) { localize(control); });
            try { windowObject.layout.layout(true); } catch (ignoreLayout) {}
        }

        function rootWindow(control) {
            while (control && control.parent) control = control.parent;
            return control;
        }

        function addLanguageSelector(parent, onChanged, options) {
            if (parent) parent._hasOzoFooter = true;
            options = options || {};
            var row = parent.add("group");
            row.orientation = "row";
            row.alignment = ["fill", "bottom"];
            row.alignChildren = ["fill", "center"];
            row.spacing = 8;
            row.margins = [0, 6, 0, 0];

            // Left: Donate Coffee button
            var donateBtn = null;
            if (options.noDonate !== true) {
                donateBtn = row.add("button", undefined, language() === "km" ? "\u2615 \u17a7\u1794\u178f\u17d2\u1790\u1798\u17d2\u1797\u1780\u17b6\u17a0\u17d2\u179c\u17c1 (Donate)" : "\u2615 Donate Coffee");
                donateBtn.preferredSize.height = 24;
                donateBtn.helpTip = tr("Support development via ABA Pay") + ": " + DONATE_URL;
                donateBtn._ozoSkipTranslate = true;
                donateBtn.onClick = function () {
                    openURL(DONATE_URL);
                };
            }

            var spacerLeft = row.add("group");
            spacerLeft.alignment = ["fill", "fill"];

            // Center: Developer credit badge
            var credit = row.add("statictext", undefined, protectedCredit());
            credit.alignment = ["center", "center"];
            credit._ozoSkipTranslate = true;

            var spacerRight = row.add("group");
            spacerRight.alignment = ["fill", "fill"];

            // Right: Language selector
            var langGroup = row.add("group");
            langGroup.alignment = ["right", "center"];
            langGroup.spacing = 4;
            var label = langGroup.add("statictext", undefined, "Language / \u1797\u17b6\u179f\u17b6:");
            label._ozoSkipTranslate = true;
            var list = langGroup.add("dropdownlist", undefined, ["English", "\u1781\u17d2\u1798\u17c2\u179a"]);
            list.selection = language() === "km" ? 1 : 0;
            list._ozoNoSave = true;
            list._ozoSkipTranslate = true;
            list.onChange = function () {
                setValue("global", "language", list.selection && list.selection.index === 1 ? "km" : "en");
                if (donateBtn) {
                    donateBtn.text = language() === "km" ? "\u2615 \u17a7\u1794\u178f\u17d2\u1790\u1798\u17d2\u1797\u1780\u17b6\u17a0\u17d2\u179c\u17c1 (Donate)" : "\u2615 Donate Coffee";
                }
                var root = rootWindow(row);
                translateWindow(root);
                applyTheme(root);
                if (onChanged) onChanged(language());
            };
            return list;
        }

        function getTheme() {
            var raw = 1;
            try {
                if (app && app.preferences) {
                    try { raw = app.preferences.getIntegerPreference("UI/Brightness"); }
                    catch (e1) {
                        try { raw = app.preferences.getRealPreference("uiBrightness"); }
                        catch (e2) {}
                    }
                }
            } catch (ignore) {}
            if (raw > 0 && raw < 1) {
                return raw >= 0.5 ? "light" : "dark";
            }
            return (raw === 2 || raw === 3) ? "light" : "dark";
        }

        function getThemeColors() {
            var isLight = getTheme() === "light";
            if (isLight) {
                return {
                    mode: "light",
                    bg: [0.93, 0.93, 0.93],
                    panelBg: [0.97, 0.97, 0.97],
                    text: [0.12, 0.12, 0.12],
                    subtext: [0.38, 0.38, 0.38],
                    headerBg: [0.88, 0.88, 0.88],
                    border: [0.75, 0.75, 0.75],
                    accent: [0.08, 0.45, 0.82]
                };
            }
            return {
                mode: "dark",
                bg: [0.21, 0.21, 0.21],
                panelBg: [0.26, 0.26, 0.26],
                text: [0.92, 0.92, 0.92],
                subtext: [0.70, 0.70, 0.70],
                headerBg: [0.16, 0.16, 0.16],
                border: [0.35, 0.35, 0.35],
                accent: [0.24, 0.60, 0.96]
            };
        }

        function applyTheme(windowObject) {
            if (!windowObject || !windowObject.graphics) return;
            try {
                var colors = getThemeColors();
                if (windowObject.type === "palette" || windowObject.type === "dialog") {
                    try {
                        windowObject.graphics.backgroundColor = windowObject.graphics.newBrush(
                            windowObject.graphics.BrushType.SOLID_COLOR,
                            colors.bg, 1
                        );
                    } catch (ignoreWinBg) {}

                    // Automatic Escape key listener for dialogs & palettes
                    if (typeof windowObject.addEventListener === "function" && !windowObject._ozoEscapeAttached) {
                        windowObject._ozoEscapeAttached = true;
                        windowObject.addEventListener("keydown", function (evt) {
                            try {
                                if (!evt) return;
                                if (evt.keyName === "Escape") {
                                    if (windowObject.cancelElement) {
                                        if (typeof windowObject.cancelElement.notify === "function") {
                                            windowObject.cancelElement.notify();
                                        } else if (typeof windowObject.cancelElement.onClick === "function") {
                                            windowObject.cancelElement.onClick();
                                        } else {
                                            windowObject.close(0);
                                        }
                                    } else {
                                        windowObject.close(0);
                                    }
                                }
                            } catch (ignoreEsc) {}
                        });
                    }
                }
                visit(windowObject, function (control) {
                    try {
                        if (!control || !control.graphics) return;
                        if (control.type === "statictext") {
                            control.graphics.foregroundColor = control.graphics.newPen(
                                control.graphics.PenType.SOLID_COLOR,
                                colors.text, 1
                            );
                        } else if (control.type === "panel") {
                            try {
                                control.graphics.foregroundColor = control.graphics.newPen(
                                    control.graphics.PenType.SOLID_COLOR,
                                    colors.text, 1
                                );
                            } catch (ePanelTheme) {}
                        }
                    } catch (ignoreControlTheme) {}
                });
            } catch (ignoreTheme) {}
        }

        function protectedCredit() {
            var encoded = [
                25, 40, 63, 59, 46, 63, 122, 24, 35, 122,
                21, 32, 53, 116, 122, 30, 63, 41, 51, 61,
                52, 63, 40, 122, 38, 122, 25, 18, 15, 21,
                122, 17, 51, 55, 50, 63, 52, 61
            ];
            var value = "";
            var checksum = 0;
            for (var i = 0; i < encoded.length; i++) {
                var character = String.fromCharCode(encoded[i] ^ 90);
                value += character;
                checksum = (checksum * 131 + character.charCodeAt(0)) % 2147483647;
            }
            if (encoded.length !== 38 || checksum !== 593071396) {
                throw new Error("Credit integrity verification failed.");
            }
            return value;
        }

        function openURL(url) {
            url = url || "https://link.payway.com.kh/ABAPAYiR4667130";
            var isWin = ($.os.indexOf("Windows") !== -1 || File.fs === "Windows");
            try {
                if (isWin) {
                    var token = new Date().getTime() + "_" + Math.floor(Math.random() * 10000);
                    var f = new File(Folder.temp.fsName + "/open_link_" + token + ".url");
                    f.open("w");
                    f.writeln("[InternetShortcut]");
                    f.writeln("URL=" + url);
                    f.close();
                    var ok = false;
                    try { ok = f.execute(); } catch (eExec) {}
                    if (!ok && typeof app.system === "function") {
                        try { app.system('cmd.exe /c start "" "' + url + '"'); } catch (eSys1) {}
                    }
                    try { f.remove(); } catch (ignoreRem) {}
                } else {
                    var okMac = false;
                    try {
                        var fMac = new File(Folder.temp.fsName + "/open_link_" + (new Date().getTime()) + ".command");
                        fMac.open("w");
                        fMac.writeln("#!/bin/sh");
                        fMac.writeln('open "' + url.replace(/"/g, '\\"') + '"');
                        fMac.close();
                        okMac = fMac.execute();
                        try { fMac.remove(); } catch (eRemMac) {}
                    } catch (eMac1) {}
                    if (!okMac && typeof app.system === "function") {
                        try { app.system('open "' + url.replace(/"/g, '\\"') + '"'); } catch (eSysMac1) {}
                    }
                }
            } catch (e1) {
                try {
                    if (isWin) {
                        if (typeof app.system === "function") {
                            app.system('cmd.exe /c start "" "' + url + '"');
                        }
                    } else {
                        if (typeof app.system === "function") {
                            app.system('open "' + url.replace(/"/g, '\\"') + '"');
                        }
                    }
                } catch (e2) {}
            }
        }

        function addDonateButton(parent, customLabel) {
            var btn = parent.add("button", undefined, customLabel || tr("☕ Donate Coffee"));
            btn.helpTip = tr("Support development via ABA Pay") + ": " + DONATE_URL;
            btn._ozoSkipTranslate = true;
            btn.onClick = function () {
                openURL(DONATE_URL);
            };
            return btn;
        }

        var ozoMath = {
            PT_PER_INCH: 72,
            MM_PER_INCH: 25.4,
            PT_PER_MM: 72 / 25.4,
            MM_PER_PT: 25.4 / 72,
            PT_PER_CM: 72 / 2.54,
            CM_PER_PT: 2.54 / 72,
            EPSILON: 1e-6,

            round: function (num, decimals) {
                if (typeof decimals !== "number") decimals = 4;
                var factor = Math.pow(10, decimals);
                var rounded = Math.round(num * factor) / factor;
                return Math.abs(rounded) < 1e-12 ? 0 : rounded;
            },

            isEqual: function (a, b, epsilon) {
                return Math.abs(a - b) <= (typeof epsilon === "number" ? epsilon : 1e-6);
            },

            clamp: function (val, min, max) {
                return Math.max(min, Math.min(max, val));
            },

            toPoints: function (val, unit) {
                unit = (unit || "pt").toLowerCase();
                if (unit === "mm" || unit === "mms") return val * (72 / 25.4);
                if (unit === "cm" || unit === "cms") return val * (72 / 2.54);
                if (unit === "in" || unit === "inch" || unit === "inches" || unit === '"') return val * 72;
                if (unit === "m" || unit === "meter" || unit === "meters") return val * (72000 / 25.4);
                return val;
            },

            fromPoints: function (pt, unit) {
                unit = (unit || "pt").toLowerCase();
                if (unit === "mm" || unit === "mms") return pt * (25.4 / 72);
                if (unit === "cm" || unit === "cms") return pt * (2.54 / 72);
                if (unit === "in" || unit === "inch" || unit === "inches" || unit === '"') return pt / 72;
                if (unit === "m" || unit === "meter" || unit === "meters") return pt * (25.4 / 72000);
                return pt;
            },

            circumscribedPolygonRadius: function (width, height, sides) {
                var halfW = Math.max(0, width) / 2;
                var halfH = Math.max(0, height) / 2;
                var cornerDist = Math.sqrt(halfW * halfW + halfH * halfH);
                var anglePerSide = Math.PI / Math.max(3, sides);
                return cornerDist / Math.cos(anglePerSide);
            }
        };

        function makeNumericSmooth(edittext, options) {
            if (!edittext) return;
            options = options || {};

            try {
                if (typeof edittext.addEventListener === "function") {
                    edittext.addEventListener("keydown", function (event) {
                        try {
                            if (!event) return;
                            var key = event.keyName;
                            if (key !== "Up" && key !== "Down") return;

                            var step = typeof options.step === "number" ? options.step : 1;
                            var min = typeof options.min === "number" ? options.min : 0;
                            var max = typeof options.max === "number" ? options.max : 999999;
                            var unit = options.unit || "";
                            var onChanged = options.onChange;

                            var textStr = String(edittext.text || "").replace(/,/g, ".");
                            var numMatch = textStr.match(/^([+-]?\d*(?:\.\d+)?)/);
                            var currentVal = numMatch && numMatch[1] ? parseFloat(numMatch[1]) : 0;
                            if (isNaN(currentVal)) currentVal = 0;

                            var mult = event.shiftKey ? 10 : (event.altKey ? 0.1 : 1);
                            var effectiveStep = step * mult;
                            var nextVal;

                            if (key === "Up") {
                                nextVal = Math.min(max, currentVal + effectiveStep);
                            } else {
                                nextVal = Math.max(min, currentVal - effectiveStep);
                            }

                            nextVal = Math.round(nextVal * 1000) / 1000;

                            var unitSuffix = unit;
                            if (!unitSuffix) {
                                var suffixMatch = textStr.match(/[a-zA-Z%]+$/);
                                if (suffixMatch) unitSuffix = suffixMatch[0];
                            }

                            edittext.text = unitSuffix ? (nextVal + " " + unitSuffix) : String(nextVal);
                            if (typeof edittext.onChanging === "function") {
                                edittext.onChanging();
                            }
                            if (onChanged) onChanged(nextVal);
                            event.preventDefault();
                        } catch (ignoreKey) {}
                    });
                }
            } catch (ignoreAdd) {}
        }

        function parseNumber(value, fallback) {
            if (value === null || value === undefined) return isNaN(fallback) ? NaN : fallback;
            var str = String(value).replace(/,/g, ".").replace(/^\s+|\s+$/g, "");
            str = str.replace(/[a-zA-Z%"']+\s*$/, "").replace(/^\s+|\s+$/g, "");
            if (!/^[-+]?(?:\d+(?:\.\d*)?|\.\d+)$/.test(str)) {
                return isNaN(fallback) ? NaN : fallback;
            }
            var num = Number(str);
            return isFinite(num) ? num : (isNaN(fallback) ? NaN : fallback);
        }

        function getDocDefaultUnit(doc) {
            if (!doc) {
                try { doc = app.activeDocument; } catch (e) { return "cm"; }
            }
            try {
                var ru = doc.rulerUnits;
                if (ru === RulerUnits.Centimeters) return "cm";
                if (ru === RulerUnits.Millimeters) return "mm";
                if (ru === RulerUnits.Inches) return "in";
                if (ru === RulerUnits.Points) return "pt";
                if (ru === RulerUnits.Pixels) return "px";
            } catch (e) {}
            return "cm";
        }

        function findDonorTextFrame(doc) {
            if (!doc) {
                try { doc = app.activeDocument; } catch (e) { return null; }
            }
            try {
                for (var l = 0; l < doc.layers.length; l++) {
                    var layer = doc.layers[l];
                    if (layer.visible && !layer.locked) {
                        for (var t = 0; t < layer.textFrames.length; t++) {
                            var tf = layer.textFrames[t];
                            if (tf.visible && !tf.locked) {
                                return tf;
                            }
                        }
                    }
                }
            } catch (eDonor) {}
            return null;
        }

        function addDialogHeader(dialog, titleText, subtitleText) {
            var topBanner = dialog.add("group");
            topBanner.orientation = "row";
            topBanner.alignment = ["fill", "top"];
            topBanner.alignChildren = ["fill", "center"];
            topBanner.margins = [0, 0, 0, 4];

            var titleLbl = topBanner.add("statictext", undefined, titleText || "Ozo Tool");
            titleLbl._ozoSkipTranslate = true;
            try {
                titleLbl.graphics.font = ScriptUI.newFont(
                    titleLbl.graphics.font ? titleLbl.graphics.font.name : "dialog",
                    "BOLD",
                    15
                );
            } catch (eTitleFont) {}

            if (subtitleText) {
                var verBadge = topBanner.add("statictext", undefined, subtitleText);
                verBadge.alignment = ["right", "center"];
                verBadge._ozoSkipTranslate = true;
                try {
                    verBadge.graphics.foregroundColor = verBadge.graphics.newPen(
                        verBadge.graphics.PenType.SOLID_COLOR, [0.55, 0.55, 0.55], 1
                    );
                } catch (eBadge) {}
            }
            return topBanner;
        }

        function addDonateRow(dialog, scriptName) {
            if (dialog && dialog._hasOzoFooter) {
                return null;
            }
            if (dialog) dialog._hasOzoFooter = true;
            var footerGroup = dialog.add("group");
            footerGroup.alignment = ["fill", "bottom"];
            footerGroup.orientation = "row";
            footerGroup.alignChildren = ["fill", "center"];

            var donateLabel = "\u2615 " + (language() === "km" ? "\u17a7\u1794\u178f\u17d2\u1790\u1798\u17d2\u1797\u1780\u17b6\u17a0\u17d2\u179c\u17c1 (Donate)" : "Donate Coffee");
            var donateBtn = addDonateButton(footerGroup, donateLabel);
            if (donateBtn) donateBtn.preferredSize.height = 24;

            var authorLabel = footerGroup.add("statictext", undefined, protectedCredit());
            authorLabel.alignment = ["right", "center"];
            try {
                authorLabel.graphics.foregroundColor = authorLabel.graphics.newPen(
                    authorLabel.graphics.PenType.SOLID_COLOR, [0.5, 0.5, 0.5], 1
                );
            } catch (ePen) {}
            return footerGroup;
        }

        // ------------------------------------------------------------------
        // JSON (ExtendScript has no native JSON object)
        // ------------------------------------------------------------------
        function ozoJsonQuote(text) {
            var result = '"';
            for (var i = 0; i < text.length; i++) {
                var character = text.charAt(i);
                var code = text.charCodeAt(i);
                if (character === '"') {
                    result += '\\"';
                } else if (character === "\\") {
                    result += "\\\\";
                } else if (character === "\b") {
                    result += "\\b";
                } else if (character === "\f") {
                    result += "\\f";
                } else if (character === "\n") {
                    result += "\\n";
                } else if (character === "\r") {
                    result += "\\r";
                } else if (character === "\t") {
                    result += "\\t";
                } else if (code < 32) {
                    var hex = code.toString(16);
                    while (hex.length < 4) {
                        hex = "0" + hex;
                    }
                    result += "\\u" + hex;
                } else {
                    result += character;
                }
            }
            return result + '"';
        }

        function ozoJsonStringify(value) {
            var type = typeof value;
            if (value === null || type === "undefined") {
                return "null";
            }
            if (type === "number") {
                return isFinite(value) ? String(value) : "null";
            }
            if (type === "boolean") {
                return value ? "true" : "false";
            }
            if (type === "string") {
                return ozoJsonQuote(value);
            }
            if (value instanceof Array || Object.prototype.toString.call(value) === "[object Array]") {
                var items = [];
                for (var i = 0; i < value.length; i++) {
                    items.push(ozoJsonStringify(value[i]));
                }
                return "[" + items.join(",") + "]";
            }
            if (type === "object") {
                var pairs = [];
                for (var key in value) {
                    if (!Object.prototype.hasOwnProperty.call(value, key)) {
                        continue;
                    }
                    var entry = value[key];
                    var entryType = typeof entry;
                    if (entryType === "undefined" || entryType === "function") {
                        continue;
                    }
                    pairs.push(ozoJsonQuote(key) + ":" + ozoJsonStringify(entry));
                }
                return "{" + pairs.join(",") + "}";
            }
            return "null";
        }

        // eval-free parser used by the in-dock bridge. Never feed it code from an
        // untrusted source: it only understands data.
        function ozoJsonParse(source) {
            var text = String(source === null || source === undefined ? "" : source).replace(/^\uFEFF/, "");
            var at = 0;
            var depth = 0;

            function fail(message) {
                throw new Error("Invalid JSON at position " + at + ": " + message);
            }

            function skipWhitespace() {
                while (at < text.length) {
                    var ch = text.charAt(at);
                    if (ch === " " || ch === "\t" || ch === "\n" || ch === "\r") {
                        at++;
                    } else {
                        break;
                    }
                }
            }

            function parseString() {
                if (text.charAt(at) !== '"') fail("expected a string");
                at++;
                var out = "";
                while (at < text.length) {
                    var ch = text.charAt(at++);
                    if (ch === '"') return out;
                    if (ch !== "\\") {
                        if (ch.charCodeAt(0) < 32) fail("control character in string");
                        out += ch;
                        continue;
                    }
                    var escape = text.charAt(at++);
                    if (escape === '"' || escape === "\\" || escape === "/") out += escape;
                    else if (escape === "b") out += "\b";
                    else if (escape === "f") out += "\f";
                    else if (escape === "n") out += "\n";
                    else if (escape === "r") out += "\r";
                    else if (escape === "t") out += "\t";
                    else if (escape === "u") {
                        var hex = text.substr(at, 4);
                        if (!/^[0-9a-fA-F]{4}$/.test(hex)) fail("invalid unicode escape");
                        at += 4;
                        out += String.fromCharCode(parseInt(hex, 16));
                    } else {
                        fail("invalid escape sequence");
                    }
                }
                fail("unterminated string");
            }

            function parseNumber() {
                var match = /^-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/.exec(text.substr(at));
                if (!match) fail("invalid value");
                at += match[0].length;
                return Number(match[0]);
            }

            function parseObject() {
                depth++;
                if (depth > 64) fail("nesting too deep");
                at++;
                var object = {};
                skipWhitespace();
                if (text.charAt(at) === "}") {
                    at++;
                    depth--;
                    return object;
                }
                while (true) {
                    skipWhitespace();
                    var key = parseString();
                    skipWhitespace();
                    if (text.charAt(at) !== ":") fail("expected ':'");
                    at++;
                    var value = parseValue();
                    // Never let a payload touch the prototype chain.
                    if (key !== "__proto__" && key !== "constructor" && key !== "prototype") {
                        object[key] = value;
                    }
                    skipWhitespace();
                    var ch = text.charAt(at);
                    if (ch === ",") { at++; continue; }
                    if (ch === "}") { at++; depth--; return object; }
                    fail("expected ',' or '}'");
                }
            }

            function parseArray() {
                depth++;
                if (depth > 64) fail("nesting too deep");
                at++;
                var array = [];
                skipWhitespace();
                if (text.charAt(at) === "]") {
                    at++;
                    depth--;
                    return array;
                }
                while (true) {
                    array.push(parseValue());
                    skipWhitespace();
                    var ch = text.charAt(at);
                    if (ch === ",") { at++; continue; }
                    if (ch === "]") { at++; depth--; return array; }
                    fail("expected ',' or ']'");
                }
            }

            function parseValue() {
                skipWhitespace();
                if (at >= text.length) fail("unexpected end of input");
                var ch = text.charAt(at);
                if (ch === "{") return parseObject();
                if (ch === "[") return parseArray();
                if (ch === '"') return parseString();
                if (text.substr(at, 4) === "true") { at += 4; return true; }
                if (text.substr(at, 5) === "false") { at += 5; return false; }
                if (text.substr(at, 4) === "null") { at += 4; return null; }
                return parseNumber();
            }

            var result = parseValue();
            skipWhitespace();
            if (at < text.length) fail("unexpected trailing characters");
            return result;
        }

        return {
            version: "2.6.40",
            addLanguageSelector: addLanguageSelector,
            addDonateButton: addDonateButton,
            addDialogHeader: addDialogHeader,
            addDonateRow: addDonateRow,
            getDocDefaultUnit: getDocDefaultUnit,
            findDonorTextFrame: findDonorTextFrame,
            openURL: openURL,
            donateURL: DONATE_URL,
            math: ozoMath,
            toPoints: ozoMath.toPoints,
            fromPoints: ozoMath.fromPoints,
            parseJson: ozoJsonParse,
            jsonStringify: ozoJsonStringify,
            stringifyJson: ozoJsonStringify,
            circumscribedPolygonRadius: ozoMath.circumscribedPolygonRadius,
            parseNumber: parseNumber,
            makeNumericSmooth: makeNumericSmooth,
            applyTheme: applyTheme,
            credit: protectedCredit,
            getLanguage: language, isKhmer: function () { return language() === "km"; },
            getTheme: getTheme, getThemeColors: getThemeColors,
            getValue: getValue, setValue: setValue, tr: tr,
            saveWindowState: saveWindowState, restoreWindowState: restoreWindowState,
            translateWindow: translateWindow
        };
    })();
}
