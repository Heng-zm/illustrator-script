            "Select an icon and click Preview.": "\u1787\u17d2\u179a\u17be\u179f\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784 \u17a0\u17be\u1799\u1785\u17bb\u1785 \u1798\u17be\u179b\u1787\u17b6\u1798\u17bb\u1793\u17d4",
            "Type a keyword to search hundreds of thousands of icons.": "\u179c\u17b6\u1799\u1796\u17b6\u1780\u17d2\u1799\u1782\u1793\u17d2\u179b\u17b9\u17c7\u178a\u17be\u1798\u17d2\u1794\u17b8\u179f\u17d2\u179c\u17c2\u1784\u179a\u1780\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u1787\u17b6\u1785\u17d2\u179a\u17be\u1793\u17d4",
            "Previous": "\u1798\u17bb\u1793", "Next": "\u1794\u1793\u17d2\u1791\u17b6\u1794\u17cb", "Page 1": "\u1791\u17c6\u1796\u17d0\u179a 1", "Select All": "\u1787\u17d2\u179a\u17be\u179f\u1791\u17b6\u17c6\u1784\u17a2\u179f\u17cb",
            "Auto preview": "\u1798\u17be\u179b\u1787\u17b6\u1798\u17bb\u1793\u179f\u17d2\u179c\u17d0\u1799\u1794\u17d2\u179a\u179c\u178f\u17d2\u178f\u17b7", "Import Layout": "\u1794\u17d2\u179b\u1784\u17cb\u1793\u17b6\u17c6\u1785\u17bc\u179b",
            "Size (mm):": "\u1791\u17c6\u17a0\u17c6 (mm)\u17d6", "Columns:": "\u1787\u17bd\u179a\u1788\u179a\u17d6", "Gap (mm):": "\u1782\u1798\u17d2\u179b\u17b6\u178f (mm)\u17d6",
            "Preview": "\u1798\u17be\u179b\u1787\u17b6\u1798\u17bb\u1793", "Download SVG...": "\u1791\u17b6\u1789\u1799\u1780 SVG...", "Import Selected": "\u1793\u17b6\u17c6\u1785\u17bc\u179b\u178a\u17c2\u179b\u1794\u17b6\u1793\u1787\u17d2\u179a\u17be\u179f",
            "Downloading icons...": "\u1780\u17c6\u1796\u17bb\u1784\u1791\u17b6\u1789\u1799\u1780\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784...",
            "Icons come from multiple open-source sets. Check the source set license before distribution.": "\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u1798\u1780\u1796\u17b8\u179f\u17c6\u178e\u17bb\u17c6\u1794\u17d2\u179a\u1797\u1796\u1794\u17be\u1780\u1785\u17c6\u17a0\u1787\u17b6\u1785\u17d2\u179a\u17be\u1793\u17d4 \u179f\u17bc\u1798\u1796\u17b7\u1793\u17b7\u178f\u17d2\u1799\u17a2\u17b6\u1787\u17d2\u1789\u17b6\u1794\u178e\u17d2\u178e\u1798\u17bb\u1793\u1785\u17c2\u1780\u1785\u17b6\u1799\u17d4",
            "icon(s) selected": "\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u1794\u17b6\u1793\u1787\u17d2\u179a\u17be\u179f", "column(s)": "\u1787\u17bd\u179a\u1788\u179a", "row(s)": "\u1787\u17bd\u179a\u178a\u17c1\u1780",
            "Icon Set": "\u179f\u17c6\u178e\u17bb\u17c6\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784", "Icon Name": "\u1788\u17d2\u1798\u17c4\u17c7\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784",
            "Previewing": "\u1780\u17c6\u1796\u17bb\u1784\u1798\u17be\u179b\u1787\u17b6\u1798\u17bb\u1793", "in this dialog.": "\u1780\u17d2\u1793\u17bb\u1784\u1794\u17d2\u179a\u17a2\u1794\u17cb\u1793\u17c1\u17c7\u17d4",
            "Loading preview for": "\u1780\u17c6\u1796\u17bb\u1784\u1795\u17d2\u1791\u17bb\u1780\u1780\u17b6\u179a\u1798\u17be\u179b\u1787\u17b6\u1798\u17bb\u1793\u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb", "Icon preview failed.": "\u1780\u17b6\u179a\u1798\u17be\u179b\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u1787\u17b6\u1798\u17bb\u1793\u1794\u179a\u17b6\u1787\u17d0\u1799\u17d4",
            "Showing": "\u1780\u17c6\u1796\u17bb\u1784\u1794\u1784\u17d2\u17a0\u17b6\u1789", "of": "\u1780\u17d2\u1793\u17bb\u1784\u1785\u17c6\u178e\u17c4\u1798", "icons.": "\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u17d4", "Page": "\u1791\u17c6\u1796\u17d0\u179a",
            "No icons found. Try a different keyword.": "\u179a\u1780\u1798\u17b7\u1793\u1783\u17be\u1789\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u1791\u17c1\u17d4 \u179f\u17b6\u1780\u179b\u17d2\u1794\u1784\u1796\u17b6\u1780\u17d2\u1799\u1782\u1793\u17d2\u179b\u17b9\u17c7\u1795\u17d2\u179f\u17c1\u1784\u17d4",
            "Enter an icon search keyword.": "\u1794\u1789\u17d2\u1785\u17bc\u179b\u1796\u17b6\u1780\u17d2\u1799\u1782\u1793\u17d2\u179b\u17b9\u17c7\u179f\u17d2\u179c\u17c2\u1784\u179a\u1780\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u17d4",
            "The icon-set prefix can contain only letters, numbers, and hyphens.": "\u1794\u17bb\u1796\u17d2\u179c\u1794\u1791\u179f\u17c6\u178e\u17bb\u17c6\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u17a2\u17b6\u1785\u1798\u17b6\u1793\u178f\u17c2\u17a2\u1780\u17d2\u179f\u179a \u179b\u17c1\u1781 \u1793\u17b7\u1784\u179f\u1789\u17d2\u1789\u17b6\u178a\u1780\u1794\u17c9\u17bb\u178e\u17d2\u178e\u17c4\u17c7\u17d4",
            "Searching Iconify for": "\u1780\u17c6\u1796\u17bb\u1784\u179f\u17d2\u179c\u17c2\u1784\u179a\u1780\u1780\u17d2\u1793\u17bb\u1784 Iconify \u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb", "Icon search failed.": "\u1780\u17b6\u179a\u179f\u17d2\u179c\u17c2\u1784\u179a\u1780\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u1794\u179a\u17b6\u1787\u17d0\u1799\u17d4",
            "Enter QR content to calculate the version and matrix size.": "\u1794\u1789\u17d2\u1785\u17bc\u179b\u1798\u17b6\u178f\u17b7\u1780\u17b6 QR \u178a\u17be\u1798\u17d2\u1794\u17b8\u1782\u178e\u1793\u17b6\u1787\u17c6\u1793\u17b6\u1793\u17cb \u1793\u17b7\u1784\u1791\u17c6\u17a0\u17c6\u1798\u17c9\u17b6\u1791\u17d2\u179a\u17b8\u179f\u17d4",
            "Ready": "\u179a\u17bd\u1785\u179a\u17b6\u179b\u17cb", "Not ready": "\u1798\u17b7\u1793\u1791\u17b6\u1793\u17cb\u179a\u17bd\u1785\u179a\u17b6\u179b\u17cb", "character(s)": "\u178f\u17bd\u17a2\u1780\u17d2\u179f\u179a",
            "Version": "\u1787\u17c6\u1793\u17b6\u1793\u17cb", "modules": "\u1798\u17c9\u17bc\u178c\u17bb\u179b", "Level": "\u1780\u1798\u17d2\u179a\u17b7\u178f",
            "Enter a finished size greater than zero.": "\u1794\u1789\u17d2\u1785\u17bc\u179b\u1791\u17c6\u17a0\u17c6\u1785\u17bb\u1784\u1780\u17d2\u179a\u17c4\u1799\u1792\u17c6\u1787\u17b6\u1784\u179f\u17bc\u1793\u17d2\u1799\u17d4",
            "Enter a whole-number quiet zone from 0 to 20 modules.": "\u1794\u1789\u17d2\u1785\u17bc\u179b\u178f\u17c6\u1794\u1793\u17cb\u1791\u17c6\u1793\u17c1\u179a\u1787\u17b6\u1785\u17c6\u1793\u17bd\u1793\u1782\u178f\u17cb\u1796\u17b8 0 \u178a\u179b\u17cb 20 \u1798\u17c9\u17bc\u178c\u17bb\u179b\u17d4",
            "The content is too long. This generator supports QR versions 1-10.": "\u1798\u17b6\u178f\u17b7\u1780\u17b6\u179c\u17c2\u1784\u1796\u17c1\u1780\u17d4 \u1780\u1798\u17d2\u1798\u179c\u17b7\u1792\u17b8\u1793\u17c1\u17c7\u1782\u17b6\u17c6\u1791\u17d2\u179a QR \u1787\u17c6\u1793\u17b6\u1793\u17cb 1 \u178a\u179b\u17cb 10\u17d4",
            "Import an old QR image or enter content manually, then create a fresh editable vector QR. No internet connection is used.": "\u1793\u17b6\u17c6\u1785\u17bc\u179b\u179a\u17bc\u1794 QR \u1785\u17b6\u179f\u17cb \u17ac\u1794\u1789\u17d2\u1785\u17bc\u179b\u1798\u17b6\u178f\u17b7\u1780\u17b6\u178a\u17c4\u1799\u178a\u17c3 \u1794\u1793\u17d2\u1791\u17b6\u1794\u17cb\u1798\u1780\u1794\u1784\u17d2\u1780\u17be\u178f QR \u179c\u17c9\u17b7\u1785\u1791\u17d0\u179a\u1790\u17d2\u1798\u17b8\u178a\u17c2\u179b\u17a2\u17b6\u1785\u1780\u17c2\u179f\u1798\u17d2\u179a\u17bd\u179b\u1794\u17b6\u1793\u17d4 \u1798\u17b7\u1793\u1794\u17d2\u179a\u17be\u17a2\u17ca\u17b8\u1793\u1792\u17ba\u178e\u17b7\u178f\u1791\u17c1\u17d4",
                        "Telegram 2026 (Share Card)": "\u1780\u17b6\u178f\u1785\u17c2\u1780\u179a\u17c6\u179b\u17c2\u1780 Telegram 2026 (Share Card)",
            "Telegram 2026 (QR Only)": "\u1780\u17bc\u178a Telegram 2026 (QR \u178f\u17c2\u1794\u17c9\u17bb\u178e\u17d2\u178e\u17c4\u17c7)",
            "Telegram Style Options": "\u1787\u1798\u17d2\u179a\u17be\u179f\u179a\u1785\u1793\u17b6\u1794\u17d0\u1791\u17d2\u1798 Telegram",
            "Color theme:": "\u1796\u178e\u17cc\u179a\u1785\u1793\u17b6\u1794\u17d0\u1791\u17d2\u1798\u17d6",
            "Official Telegram Blue": "\u1796\u178e\u17cc\u1781\u17c0\u179c\u1795\u17d2\u179b\u17bc\u179c\u1780\u17b6\u179a Telegram",
            "Vibrant Cyan": "\u1796\u178e\u17cc\u1795\u17d2\u1791\u17c3\u1798\u17c1\u1788 (Cyan)",
            "Midnight Dark": "\u1796\u178e\u17cc\u1784\u1784\u17b9\u178f\u179a\u17b6\u178f\u17d2\u179a\u17b8 (Dark)",
            "Classic Black": "\u1796\u178e\u17cc\u1781\u17d2\u1798\u17c5\u1794\u17bb\u179a\u17b6\u178e",
            "Display name:": "\u1788\u17d2\u1798\u17c4\u17c7\u1794\u1784\u17d2\u17a0\u17b6\u1789\u17d6",
            "Username / link:": "\u1788\u17d2\u1798\u17c4\u17c7\u1782\u178e\u1793\u17b8 / \u178f\u17c6\u178e\u17d6",
            "Error correction:": "\u1780\u17b6\u179a\u1780\u17c2\u1780\u17c6\u17a0\u17bb\u179f\u17d6",
            "Scan with camera to open on Telegram": "\u179f\u17d2\u1780\u17c1\u1793\u1787\u17b6\u1798\u17bd\u1799\u1780\u17b6\u1798\u17c1\u179a\u17c9\u17b6\u178a\u17be\u1798\u17d2\u1794\u17b8\u1794\u17be\u1780\u179b\u17be Telegram",
            "Telegram 2026 (Share Card) generates the authentic Telegram card layout (rounded card, avatar badge, name, username, and Telegram Blue QR) exactly like saving from Telegram.": "Telegram 2026 (Share Card) \u1794\u1784\u17d2\u1780\u17be\u178f\u179a\u1785\u1793\u17b6\u1794\u17d0\u1791\u17d2\u1798\u1780\u17b6\u178f Telegram \u178a\u17bc\u1785\u179a\u17bc\u1794\u178a\u17c2\u179b\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u1785\u17c1\u1789\u1796\u17b8 Telegram (\u1780\u17b6\u178f\u1787\u17d2\u179a\u17bb\u1784\u1798\u17bc\u179b, \u179a\u17bc\u1794 Avatar, \u1788\u17d2\u1798\u17c4\u17c7, username \u1793\u17b7\u1784 QR \u1781\u17c0\u179c)\u17d4",
            "Telegram 2026 (QR Only) generates the standalone Telegram Blue vector QR code with connected rounded modules, squircle finders, and official paper-plane badge.": "Telegram 2026 (QR Only) \u1794\u1784\u17d2\u1780\u17be\u178f\u178f\u17c2\u1780\u17bc\u178a QR \u179c\u17c9\u17b7\u1785\u1791\u17d0\u179a Telegram \u1796\u178e\u17cc\u1781\u17c0\u179c \u1787\u17b6\u1798\u17bd\u1799\u1798\u17c9\u17bc\u178c\u17bb\u179b\u1787\u17d2\u179a\u17bb\u1784\u1798\u17bc\u179b \u1793\u17b7\u1784\u1795\u17d2\u179b\u17b6\u1780\u1799\u1793\u17d2\u178f\u17a0\u17c4\u17c7\u1780\u17d2\u179a\u178a\u17b6\u179f\u17d4",
"Telegram 2026 uses connected black modules, source-matched rounded finders, the official blue paper-plane badge, and Telegram's M error correction.": "Telegram 2026 \u1794\u17d2\u179a\u17be\u1798\u17c9\u17bc\u178c\u17bb\u179b\u1781\u17d2\u1798\u17c5\u178f\u1797\u17d2\u1787\u17b6\u1794\u17cb \u1780\u17d2\u179a\u17a1\u17b6\u179f\u17d2\u179c\u17c2\u1784\u179a\u1780\u1787\u17d2\u179a\u17bb\u1784\u1798\u17bc\u179b \u1795\u17d2\u179b\u17b6\u1780\u1799\u1793\u17d2\u178f\u17a0\u17c4\u17c7\u1780\u17d2\u179a\u178a\u17b6\u179f\u1796\u178e\u17cc\u1781\u17c0\u179c\u1795\u17d2\u179b\u17bc\u179c\u1780\u17b6\u179a \u1793\u17b7\u1784\u1780\u1798\u17d2\u179a\u17b7\u178f\u1780\u17c2\u1780\u17c6\u17a0\u17bb\u179f M\u17d4",
            "Normal style creates editable square vector modules. No internet connection is used.": "\u179a\u1785\u1793\u17b6\u1794\u17d0\u1791\u17d2\u1798\u1792\u1798\u17d2\u1798\u178f\u17b6\u1794\u1784\u17d2\u1780\u17be\u178f\u1798\u17c9\u17bc\u178c\u17bb\u179b\u179c\u17c9\u17b7\u1785\u1791\u17d0\u179a\u179a\u17b6\u1784\u1780\u17b6\u179a\u17c9\u17c1\u178a\u17c2\u179b\u17a2\u17b6\u1785\u1780\u17c2\u179f\u1798\u17d2\u179a\u17bd\u179b\u1794\u17b6\u1793\u17d4 \u1798\u17b7\u1793\u1794\u17d2\u179a\u17be\u17a2\u17ca\u17b8\u1793\u1792\u17ba\u178e\u17b7\u178f\u1791\u17c1\u17d4",

            "Nesting": "\u179a\u17c0\u1794\u1785\u17c6\u179f\u1798\u17d2\u1797\u17b6\u179a\u17c8", "Sheets / Containers": "\u179f\u1793\u17d2\u179b\u17b9\u1780 / \u1795\u17d2\u1791\u17c3\u178a\u17b6\u1780\u17cb",
            "Active artboard": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u179f\u1780\u1798\u17d2\u1798", "All artboards": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u1791\u17b6\u17c6\u1784\u17a2\u179f\u17cb",
            "Last selected object": "\u179c\u178f\u17d2\u1790\u17bb\u178a\u17c2\u179b\u1794\u17b6\u1793\u1787\u17d2\u179a\u17be\u179f\u1785\u17bb\u1784\u1780\u17d2\u179a\u17c4\u1799", "Units": "\u17af\u1780\u178f\u17b6",
            "Use custom active sheet size": "\u1794\u17d2\u179a\u17be\u1791\u17c6\u17a0\u17c6\u179f\u1793\u17d2\u179b\u17b9\u1780\u179f\u1780\u1798\u17d2\u1798\u1795\u17d2\u1791\u17b6\u179b\u17cb\u1781\u17d2\u179b\u17bd\u1793",
            "Width": "\u1791\u1791\u17b9\u1784", "Height": "\u1780\u1798\u17d2\u1796\u179f\u17cb", "Margins": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1782\u17c2\u1798",
            "Left": "\u1786\u17d2\u179c\u17c1\u1784", "Right": "\u179f\u17d2\u178a\u17b6\u17c6", "Top": "\u179b\u17be", "Bottom": "\u1780\u17d2\u179a\u17c4\u1798",
            "Placement": "\u1780\u17b6\u179a\u178a\u17b6\u1780\u17cb", "Min. distance": "\u1785\u1798\u17d2\u1784\u17b6\u1799\u17a2\u1794\u17d2\u1794\u1794\u179a\u1798\u17b6",
            "Edge padding": "\u1785\u1793\u17d2\u179b\u17c4\u17c7\u1796\u17b8\u1782\u17c2\u1798", "Optimization": "\u1780\u17b6\u179a\u1794\u1784\u17d2\u1780\u17be\u1793\u1794\u17d2\u179a\u179f\u17b7\u1791\u17d2\u1792\u1797\u17b6\u1796",
            "Approximation quality": "\u1782\u17bb\u178e\u1797\u17b6\u1796\u1794\u17d2\u179a\u17a0\u17b6\u1780\u17cb\u1794\u17d2\u179a\u17a0\u17c2\u179b", "Rotation": "\u1780\u17b6\u179a\u1794\u1784\u17d2\u179c\u17b7\u179b",
            "Do not rotate": "\u1780\u17bb\u17c6\u1794\u1784\u17d2\u179c\u17b7\u179b", "Auto": "\u179f\u17d2\u179c\u17d0\u1799\u1794\u17d2\u179a\u179c\u178f\u17d2\u178f\u17b7", "High": "\u1781\u17d2\u1796\u179f\u17cb",
            "Middle": "\u1798\u1792\u17d2\u1799\u1798", "Low": "\u1791\u17b6\u1794", "Search best result": "\u179f\u17d2\u179c\u17c2\u1784\u179a\u1780\u179b\u1791\u17d2\u1792\u1795\u179b\u179b\u17d2\u17a2\u1794\u17c6\u1795\u17bb\u178f",
            "Screen Preview": "\u1780\u17b6\u179a\u1798\u17be\u179b\u1787\u17b6\u1798\u17bb\u1793\u179b\u17be\u17a2\u17c1\u1780\u17d2\u179a\u1784\u17cb", "Ready to preview.": "\u179a\u17bd\u1785\u179a\u17b6\u179b\u17cb\u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb\u1798\u17be\u179b\u1787\u17b6\u1798\u17bb\u1793\u17d4",

            "Pathfinder": "\u1795\u17d2\u179f\u17c6\u179a\u17b6\u1784", "Operation": "\u1794\u17d2\u179a\u178f\u17b7\u1794\u178f\u17d2\u178f\u17b7\u1780\u17b6\u179a", "Result": "\u179b\u1791\u17d2\u1792\u1795\u179b",
            "Unite": "\u1794\u1789\u17d2\u1785\u17bc\u179b\u1782\u17d2\u1793\u17b6", "Minus Front": "\u178a\u1780\u1795\u17d2\u1793\u17c2\u1780\u1781\u17b6\u1784\u1798\u17bb\u1781",
            "Intersect": "\u1795\u17d2\u1793\u17c2\u1780\u1794\u17d2\u179a\u179f\u1796\u17d2\u179c", "Exclude": "\u178a\u1780\u1795\u17d2\u1793\u17c2\u1780\u1794\u17d2\u179a\u179f\u1796\u17d2\u179c\u1785\u17c1\u1789",
            "Divide": "\u1794\u17c2\u1784\u1785\u17c2\u1780", "Trim": "\u1780\u17b6\u178f\u17cb\u178f\u1798\u17d2\u179a\u17b9\u1798", "Merge": "\u1794\u1789\u17d2\u1785\u17bc\u179b",
            "Crop": "\u1785\u17d2\u179a\u17b9\u1794", "Outline": "\u1782\u17d2\u179a\u17c4\u1784\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb", "Minus Back": "\u178a\u1780\u1795\u17d2\u1793\u17c2\u1780\u1781\u17b6\u1784\u1780\u17d2\u179a\u17c4\u1799",
            "[+] Expand the Pathfinder result": "[+] \u1796\u1784\u17d2\u179a\u17b8\u1780\u179b\u1791\u17d2\u1792\u1795\u179b Pathfinder",
            "[#] Return individual result objects": "[#] \u1794\u1784\u17d2\u17a0\u17b6\u1789\u179c\u178f\u17d2\u1790\u17bb\u179b\u1791\u17d2\u1792\u1795\u179b\u178a\u17b6\u1785\u17cb\u178a\u17c4\u1799\u17a1\u17c2\u1780",
            "[-] Remove empty result groups": "[-] \u179b\u17bb\u1794\u1780\u17d2\u179a\u17bb\u1798\u179b\u1791\u17d2\u1792\u1795\u179b\u1791\u1791\u17c1",
            "[2] Process Minus operations in pairs": "[2] \u178a\u17c6\u178e\u17be\u179a\u1780\u17b6\u179a\u178a\u1780\u1787\u17b6\u1782\u17bc",
            "[>] Update Preview": "[>] \u1792\u17d2\u179c\u17be\u1794\u1785\u17d2\u1785\u17bb\u1794\u17d2\u1794\u1793\u17d2\u1793\u1797\u17b6\u1796\u1780\u17b6\u179a\u1798\u17be\u179b\u1787\u17b6\u1798\u17bb\u1793",
            "[X] Cancel": "[X] \u1794\u17c4\u17c7\u1794\u1784\u17cb", "[OK] Apply": "[OK] \u17a2\u1793\u17bb\u179c\u178f\u17d2\u178f",

            "Sequential Numbering": "\u179b\u17c1\u1781\u179a\u17c0\u1784", "Sequence": "\u179b\u17c6\u178a\u17b6\u1794\u17cb\u179b\u17c1\u1781",
            "Start:": "\u1785\u17b6\u1794\u17cb\u1795\u17d2\u178a\u17be\u1798\u17d6", "End:": "\u1794\u1789\u17d2\u1785\u1794\u17cb\u17d6", "Padding:": "\u1781\u17d2\u1791\u1784\u17cb\u1794\u17c6\u1796\u17c1\u1789\u17d6",
            "Prefix": "\u17a2\u1780\u17d2\u179f\u179a\u1781\u17b6\u1784\u1798\u17bb\u1781", "Suffix": "\u17a2\u1780\u17d2\u179f\u179a\u1781\u17b6\u1784\u1780\u17d2\u179a\u17c4\u1799", "Layout": "\u1794\u17d2\u179b\u1784\u17cb",
            "Mode:": "\u179a\u1794\u17c0\u1794\u17d6", "N-up grid": "\u1780\u17d2\u179a\u17a1\u17b6\u1785\u17d2\u179a\u17be\u1793\u1787\u17bd\u179a",
            "Matching position across artboards": "\u1791\u17b8\u178f\u17b6\u17c6\u1784\u178a\u17bc\u1785\u1782\u17d2\u1793\u17b6\u178f\u17b6\u1798\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a",
            "Units:": "\u17af\u1780\u178f\u17b6\u17d6", "Columns": "\u1785\u17c6\u1793\u17bd\u1793\u1787\u17bd\u179a\u1788\u179a",
            "Horizontal step": "\u1785\u1793\u17d2\u179b\u17c4\u17c7\u1795\u17d2\u178a\u17c1\u1780", "Vertical step": "\u1785\u1793\u17d2\u179b\u17c4\u17c7\u1794\u1789\u17d2\u1788\u179a",
            "Start X": "\u1785\u17c6\u178e\u17bb\u1785\u1785\u17b6\u1794\u17cb\u1795\u17d2\u178a\u17be\u1798 X", "Start Y": "\u1785\u17c6\u178e\u17bb\u1785\u1785\u17b6\u1794\u17cb\u1795\u17d2\u178a\u17be\u1798 Y",
            "Reference/start artboard:": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u1799\u17c4\u1784/\u1785\u17b6\u1794\u17cb\u1795\u17d2\u178a\u17be\u1798\u17d6",
            "Template after Apply": "\u1796\u17bb\u1798\u17d2\u1796\u1794\u1793\u17d2\u1791\u17b6\u1794\u17cb\u1796\u17b8\u17a2\u1793\u17bb\u179c\u178f\u17d2\u178f", "Action:": "\u179f\u1780\u1798\u17d2\u1798\u1797\u17b6\u1796\u17d6",
            "Hide source template": "\u179b\u17b6\u1780\u17cb\u1796\u17bb\u1798\u17d2\u1796\u178a\u17be\u1798", "Lock source template": "\u1785\u17b6\u1780\u17cb\u179f\u17c4\u1796\u17bb\u1798\u17d2\u1796\u178a\u17be\u1798",
            "Keep source template": "\u179a\u1780\u17d2\u179f\u17b6\u1796\u17bb\u1798\u17d2\u1796\u178a\u17be\u1798",

            "Smart Dimension": "\u179c\u17b6\u179f\u17cb\u1791\u17c6\u17a0\u17c6\u1786\u17d2\u179b\u17b6\u178f\u179c\u17c3", "Measurement": "\u1780\u17b6\u179a\u179c\u17b6\u179f\u17cb\u179c\u17c2\u1784",
            "Dimension:": "\u1794\u17d2\u179a\u1797\u17c1\u1791\u1791\u17c6\u17a0\u17c6\u17d6", "Overall width": "\u1791\u1791\u17b9\u1784\u179f\u179a\u17bb\u1794",
            "Overall height": "\u1780\u1798\u17d2\u1796\u179f\u17cb\u179f\u179a\u17bb\u1794", "Overall width + height": "\u1791\u1791\u17b9\u1784 + \u1780\u1798\u17d2\u1796\u179f\u17cb\u179f\u179a\u17bb\u1794",
            "Use bounds:": "\u1794\u17d2\u179a\u17be\u1796\u17d2\u179a\u17c6\u178a\u17c2\u1793\u17d6", "Visible bounds (include strokes)": "\u1796\u17d2\u179a\u17c6\u178a\u17c2\u1793\u1798\u17be\u179b\u1783\u17be\u1789 (\u179a\u17bd\u1798\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb)",
            "Geometric bounds": "\u1796\u17d2\u179a\u17c6\u178a\u17c2\u1793\u1792\u179a\u178e\u17b8\u1798\u17b6\u178f\u17d2\u179a", "Units and Scale": "\u17af\u1780\u178f\u17b6 \u1793\u17b7\u1784 \u1798\u17b6\u178f\u17d2\u179a\u178a\u17d2\u178b\u17b6\u1793",
            "Precision:": "\u1781\u17d2\u1791\u1784\u17cb\u1791\u179f\u1797\u17b6\u1782\u17d6", "Show unit": "\u1794\u1784\u17d2\u17a0\u17b6\u1789\u17af\u1780\u178f\u17b6",
            "Dimension Style": "\u179a\u1785\u1793\u17b6\u1794\u17d0\u1791\u17d2\u1798\u1791\u17c6\u17a0\u17c6", "Offset": "\u1785\u1798\u17d2\u1784\u17b6\u1799\u1796\u17b8\u179c\u178f\u17d2\u1790\u17bb",
            "Text size": "\u1791\u17c6\u17a0\u17c6\u17a2\u1780\u17d2\u179f\u179a", "Arrow size": "\u1791\u17c6\u17a0\u17c6\u1796\u17d2\u179a\u17bd\u1789",
            "Line weight": "\u1780\u1798\u17d2\u179a\u17b6\u179f\u17cb\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb", "selected unit": "\u17af\u1780\u178f\u17b6\u178a\u17c2\u179b\u1794\u17b6\u1793\u1787\u17d2\u179a\u17be\u179f",
            "White background behind labels": "\u1795\u17d2\u1791\u17c3\u179f\u1781\u17b6\u1784\u1780\u17d2\u179a\u17c4\u1799\u179f\u17d2\u179b\u17b6\u1780",

            "Object Repeat": "\u1792\u17d2\u179c\u17be\u179c\u178f\u17d2\u1790\u17bb\u178a\u178a\u17c2\u179b\u17d7",
            "Repeat Artwork Across an Artboard": "\u1792\u17d2\u179c\u17be\u179f\u17d2\u1793\u17b6\u178a\u17c3\u178a\u178a\u17c2\u179b\u17d7\u179b\u17be\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a",
            "Dimension unit:": "\u17af\u1780\u178f\u17b6\u1791\u17c6\u17a0\u17c6\u17d6",
            "Millimeters (mm)": "\u1798\u17b8\u179b\u17b8\u1798\u17c9\u17c2\u178f\u17d2\u179a (mm)", "Centimeters (cm)": "\u179f\u1784\u17cb\u1791\u17b8\u1798\u17c9\u17c2\u178f\u17d2\u179a (cm)",
            "Inches (in)": "\u17a2\u17ca\u17b8\u1789 (in)", "Points (pt)": "\u1796\u17b7\u1793\u17d2\u1791\u17bb (pt)", "Pixels (px)": "\u1797\u17b8\u1780\u179f\u17c2\u179b (px)",
            "Illustrator treats 1 px as 1 pt in scripts.": "Illustrator \u1785\u17b6\u178f\u17cb\u1791\u17bb\u1780 1 px \u179f\u17d2\u1798\u17be 1 pt \u1780\u17d2\u1793\u17bb\u1784\u179f\u17d2\u1782\u17d2\u179a\u17b8\u1794\u17d4",
            "Dimension values convert automatically.": "\u178f\u1798\u17d2\u179b\u17c3\u1791\u17c6\u17a0\u17c6\u1794\u1798\u17d2\u179b\u17c2\u1784\u178a\u17c4\u1799\u179f\u17d2\u179c\u17d0\u1799\u1794\u17d2\u179a\u179c\u178f\u17d2\u178f\u17b7\u17d4",
            "Quick preset:": "\u1780\u17b6\u179a\u1780\u17c6\u178e\u178f\u17cb\u179a\u17a0\u17d0\u179f\u17d6", "Simple Grid": "\u1780\u17d2\u179a\u17a1\u17b6\u1785\u178f\u17d2\u179a\u1784\u17d2\u1782\u1792\u1798\u17d2\u1798\u178f\u17b6",
            "Sticker Sheet": "\u179f\u1793\u17d2\u179b\u17b9\u1780\u179f\u17d2\u1791\u17b8\u1782\u17d0\u179a", "Brick Pattern": "\u179b\u17c6\u1793\u17b6\u17c6\u17a5\u178a\u17d2\u178b",
            "Random Scatter": "\u179a\u17b6\u1799\u1794\u17c9\u17b6\u1799\u1785\u17c3\u178a\u1793\u17d2\u1799", "Apply Preset": "\u17a2\u1793\u17bb\u179c\u178f\u17d2\u178f\u1780\u17b6\u179a\u1780\u17c6\u178e\u178f\u17cb",
            "Source Artwork": "\u179f\u17d2\u1793\u17b6\u178a\u17c3\u178a\u17be\u1798", "Repeat:": "\u1792\u17d2\u179c\u17be\u178a\u178a\u17c2\u179b\u17d6",
            "Selected objects": "\u179c\u178f\u17d2\u1790\u17bb\u178a\u17c2\u179b\u1794\u17b6\u1793\u1787\u17d2\u179a\u17be\u179f",
            "Top-level objects in active layer": "\u179c\u178f\u17d2\u1790\u17bb\u1780\u1798\u17d2\u179a\u17b7\u178f\u179b\u17be\u1780\u17d2\u1793\u17bb\u1784\u179f\u17d2\u179a\u1791\u17b6\u1794\u17cb\u179f\u1780\u1798\u17d2\u1798",
            "Scale (%):": "\u1798\u17b6\u178f\u17d2\u179a\u178a\u17d2\u178b\u17b6\u1793 (%)\u17d6", "Tile width (0 = off):": "\u1791\u1791\u17b9\u1784\u1780\u17d2\u179a\u17a1\u17b6 (0 = \u1794\u17b7\u1791)\u17d6",
            "Height:": "\u1780\u1798\u17d2\u1796\u179f\u17cb\u17d6", "Sizing mode:": "\u179a\u1794\u17c0\u1794\u1780\u17c6\u178e\u178f\u17cb\u1791\u17c6\u17a0\u17c6\u17d6",
            "Fit proportionally": "\u1794\u17d2\u178f\u17bc\u179a\u1791\u17c6\u17a0\u17c6\u179a\u1780\u17d2\u179f\u17b6\u179f\u1798\u17b6\u1798\u17b6\u178f\u17d2\u179a",
            "Exact width and height": "\u1791\u1791\u17b9\u1784 \u1793\u17b7\u1784\u1780\u1798\u17d2\u1796\u179f\u17cb\u1787\u17b6\u1780\u17cb\u179b\u17b6\u1780\u17cb",
            "Target Artboard": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u1782\u17c4\u179b\u178a\u17c5", "Create a new artboard": "\u1794\u1784\u17d2\u1780\u17be\u178f\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u1790\u17d2\u1798\u17b8",
            "Use active artboard": "\u1794\u17d2\u179a\u17be\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u179f\u1780\u1798\u17d2\u1798",
            "Resize active artboard": "\u1794\u17d2\u178f\u17bc\u179a\u1791\u17c6\u17a0\u17c6\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u179f\u1780\u1798\u17d2\u1798", "Width:": "\u1791\u1791\u17b9\u1784\u17d6",
            "Swap": "\u1794\u17d2\u178f\u17bc\u179a\u1782\u17d2\u1793\u17b6", "New artboard position:": "\u1791\u17b8\u178f\u17b6\u17c6\u1784\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u1790\u17d2\u1798\u17b8\u17d6",
            "Right of active": "\u1781\u17b6\u1784\u179f\u17d2\u178f\u17b6\u17c6\u1793\u17c3\u1795\u17d2\u1791\u17b6\u17c6\u1784\u179f\u1780\u1798\u17d2\u1798", "Below active": "\u1781\u17b6\u1784\u1780\u17d2\u179a\u17c4\u1798\u1795\u17d2\u1791\u17b6\u17c6\u1784\u179f\u1780\u1798\u17d2\u1798",
            "Gap:": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u17d6", "Basic Layout": "\u1794\u17d2\u179b\u1784\u17cb\u1798\u17bc\u179b\u178a\u17d2\u178b\u17b6\u1793", "Advanced": "\u1780\u1798\u17d2\u179a\u17b7\u178f\u1781\u17d2\u1796\u179f\u17cb",
            "Repeat Layout": "\u1794\u17d2\u179b\u1784\u17cb\u1792\u17d2\u179c\u17be\u178a\u178a\u17c2\u179b", "Horizontal space:": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1795\u17d2\u178a\u17c1\u1780\u17d6",
            "Vertical space:": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1794\u1789\u17d2\u1788\u179a\u17d6", "Columns (0 = Auto):": "\u1787\u17bd\u179a\u1788\u179a (0 = \u179f\u17d2\u179c\u17d0\u1799\u1794\u17d2\u179a\u179c\u178f\u17d2\u178f\u17b7)\u17d6",
            "Rows (0 = Auto):": "\u1787\u17bd\u179a\u178a\u17c1\u1780 (0 = \u179f\u17d2\u179c\u17d0\u1799\u1794\u17d2\u179a\u179c\u178f\u17d2\u178f\u17b7)\u17d6", "Margin X:": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1782\u17c2\u1798 X\u17d6",
            "Margin Y:": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1782\u17c2\u1798 Y\u17d6", "Pattern:": "\u179b\u17c6\u1793\u17b6\u17c6\u17d6", "Grid": "\u1780\u17d2\u179a\u17a1\u17b6\u1785\u178f\u17d2\u179a\u1784\u17d2\u1782",
            "Brick rows": "\u1787\u17bd\u179a\u17a5\u178a\u17d2\u178b", "Brick columns": "\u1787\u17bd\u179a\u1788\u179a\u17a5\u178a\u17d2\u178b",
            "Honeycomb (Hexagonal)": "\u179f\u17c6\u1794\u17bb\u1780\u1783\u17d2\u1798\u17bb\u17c6 (Honeycomb)",
            "Grid (Fit Artboard)": "\u1780\u17d2\u179a\u17a1\u17b6\u1785\u178f\u17d2\u179a\u1784\u17d2\u1782 (\u1794\u17c6\u1796\u17c1\u1789\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a)",
            "Grid (Fixed Step & Repeat)": "\u1780\u17d2\u179a\u17a1\u17b6\u1785\u178f\u17d2\u179a\u1784\u17d2\u1782 (\u1780\u17c6\u178e\u178f\u17cb\u1785\u17c6\u1793\u17bd\u1793 Step & Repeat)",
            "Radial (Circular Array)": "\u179a\u1784\u17d2\u179c\u1784\u17cb\u1798\u17bc\u179b (Radial Array)",
            "Distribute evenly across artboard": "\u1785\u17c2\u1780\u1782\u1798\u17d2\u179b\u17b6\u178f\u179f\u17d2\u1798\u17be\u1782\u17d2\u1793\u17b6\u1796\u17c1\u1789\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a",
            "Radius:": "\u1780\u17b6\u17c6\u179a\u1784\u17d2\u179c\u1784\u17cb (Radius)\u17d6",
            "Total Angle (\u00b0):": "\u1798\u17bb\u17c6\u179f\u179a\u17bb\u1794 (\u178a\u17ba\u1780\u17d2\u179a\u17c1)\u17d6",
            "Start Angle (\u00b0):": "\u1798\u17bb\u17c6\u1785\u17b6\u1794\u17cb\u1795\u17d2\u178a\u17be\u1798 (\u178a\u17ba\u1780\u17d2\u179a\u17c1)\u17d6",
            "Rotate items along circle": "\u1794\u1784\u17d2\u179c\u17b7\u179b\u179c\u178f\u17d2\u1790\u17bb\u178f\u17b6\u1798\u1794\u1784\u17d2\u1780\u17c4\u1784\u179a\u1784\u17d2\u179c\u1784\u17cb",
            "Circle Center:": "\u1785\u17c6\u178e\u17bb\u1785\u1795\u17d2\u1785\u17b7\u178f\u17d6",
            "Center of active artboard": "\u1795\u17d2\u1785\u17b7\u178f\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u179f\u1780\u1798\u17d2\u1798",
            "Center of source artwork": "\u1795\u17d2\u1785\u17b7\u178f\u179c\u178f\u17d2\u1790\u17bb\u178a\u17be\u1798",
            "Copies:": "\u1785\u17c6\u1793\u17bd\u1793\u1785\u1798\u17d2\u179b\u1784\u17d6",
            "Columns:": "\u1787\u17bd\u179a\u1788\u179a\u17d6",
            "Update Preview": "\u1798\u17be\u179b\u1787\u17b6\u1798\u17bb\u1793",
            "Alternating:": "\u1786\u17d2\u179b\u17b6\u179f\u17cb\u1782\u17d2\u1793\u17b6\u17d6",
            "None": "\u1782\u17d2\u1798\u17b6\u1793", "Rotate 180": "\u1794\u1784\u17d2\u179c\u17b7\u179b 180", "Flip horizontal": "\u178f\u17d2\u179a\u17a1\u1794\u17cb\u1795\u17d2\u178a\u17c1\u1780",
            "Flip vertical": "\u178f\u17d2\u179a\u17a1\u1794\u17cb\u1794\u1789\u17d2\u1788\u179a", "Stagger (%):": "\u1780\u17b6\u179a\u179a\u17c6\u1780\u17b7\u179b (%)\u17d6",
            "Center complete pattern": "\u178a\u17b6\u1780\u17cb\u179b\u17c6\u1793\u17b6\u17c6\u1791\u17b6\u17c6\u1784\u1798\u17bc\u179b\u1780\u178e\u17d2\u178a\u17b6\u179b",
            "Keep copies inside margins": "\u179a\u1780\u17d2\u179f\u17b6\u1785\u17d2\u1794\u17b6\u1794\u17cb\u1785\u1798\u17d2\u179b\u1784\u1780\u17d2\u1793\u17bb\u1784\u1782\u1798\u17d2\u179b\u17b6\u178f\u1782\u17c2\u1798",
            "Auto-fit oversized artwork to the available area": "\u1794\u1784\u17d2\u179a\u17bd\u1798\u179f\u17d2\u1793\u17b6\u178a\u17c3\u1792\u17c6\u1796\u17c1\u1780\u17b1\u17d2\u1799\u179f\u1798\u1793\u17b9\u1784\u1795\u17d2\u1791\u17c3\u178a\u17c2\u179b\u17a2\u17b6\u1785\u1794\u17d2\u179a\u17be\u1794\u17b6\u1793\u178a\u17c4\u1799\u179f\u17d2\u179c\u17d0\u1799\u1794\u17d2\u179a\u179c\u178f\u17d2\u178f\u17b7",
            "Rotation and Random Variation": "\u1780\u17b6\u179a\u1794\u1784\u17d2\u179c\u17b7\u179b \u1793\u17b7\u1784\u1794\u1798\u17d2\u179a\u17c2\u1794\u1798\u17d2\u179a\u17bd\u179b\u1785\u17c3\u178a\u1793\u17d2\u1799",
            "Base rotation (deg):": "\u1798\u17bb\u17c6\u1794\u1784\u17d2\u179c\u17b7\u179b\u1782\u17c4\u179b (\u178a\u17ba\u1780\u17d2\u179a\u17c1)\u17d6", "Random +/-:": "\u1785\u17c3\u178a\u1793\u17d2\u1799 +/-\u17d6",
            "Scale +/- (%):": "\u1798\u17b6\u178f\u17d2\u179a\u178a\u17d2\u178b\u17b6\u1793 +/- (%)\u17d6", "Position jitter:": "\u179a\u17c6\u1780\u17b7\u179b\u1791\u17b8\u178f\u17b6\u17c6\u1784\u17d6",
            "Minimum opacity (%):": "\u1797\u17b6\u1796\u179f\u17d2\u179a\u17a2\u17b6\u1794\u17cb\u17a2\u1794\u17d2\u1794\u1794\u179a\u1798\u17b6 (%)\u17d6", "Seed:": "\u1782\u17d2\u179a\u17b6\u1794\u17cb\u179b\u17c1\u1781\u17d6",
            "Output and Safety": "\u179b\u1791\u17d2\u1792\u1795\u179b \u1793\u17b7\u1784\u179f\u17bb\u179c\u178f\u17d2\u1790\u17b7\u1797\u17b6\u1796", "Layer name:": "\u1788\u17d2\u1798\u17c4\u17c7\u179f\u17d2\u179a\u1791\u17b6\u1794\u17cb\u17d6",
            "Select repeated artwork": "\u1787\u17d2\u179a\u17be\u179f\u179f\u17d2\u1793\u17b6\u178a\u17c3\u178a\u17c2\u179b\u1794\u17b6\u1793\u1792\u17d2\u179c\u17be\u178a\u178a\u17c2\u179b",
            "Clip output to artboard bounds": "\u1780\u17b6\u178f\u17cb\u179b\u1791\u17d2\u1792\u1795\u179b\u178f\u17b6\u1798\u1796\u17d2\u179a\u17c6\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a",
            "Ready.": "\u179a\u17bd\u1785\u179a\u17b6\u179b\u17cb\u17d4", "Create Repeat": "\u1794\u1784\u17d2\u1780\u17be\u178f\u1780\u17b6\u179a\u1792\u17d2\u179c\u17be\u178a\u178a\u17c2\u179b",
            "Preset applied. Review settings, then click Create Repeat.": "\u1794\u17b6\u1793\u17a2\u1793\u17bb\u179c\u178f\u17d2\u178f\u1780\u17b6\u179a\u1780\u17c6\u178e\u178f\u17cb\u17d4 \u1796\u17b7\u1793\u17b7\u178f\u17d2\u1799\u1780\u17b6\u179a\u1780\u17c6\u178e\u178f\u17cb \u179a\u17bd\u1785\u1785\u17bb\u1785 \u1794\u1784\u17d2\u1780\u17be\u178f\u1780\u17b6\u179a\u1792\u17d2\u179c\u17be\u178a\u178a\u17c2\u179b\u17d4",
            "source object(s). Active layer:": "\u179c\u178f\u17d2\u1790\u17bb\u178a\u17be\u1798\u17d4 \u179f\u17d2\u179a\u1791\u17b6\u1794\u17cb\u179f\u1780\u1798\u17d2\u1798\u17d6",
            "must be between": "\u178f\u17d2\u179a\u17bc\u179c\u179f\u17d2\u1790\u17b7\u178f\u1793\u17c5\u1785\u1793\u17d2\u179b\u17c4\u17c7", "and": "\u1793\u17b7\u1784",
            "must be a whole number.": "\u178f\u17d2\u179a\u17bc\u179c\u1787\u17b6\u1785\u17c6\u1793\u17bd\u1793\u1782\u178f\u17cb\u17d4",
            "No usable source artwork was found.": "\u179a\u1780\u1798\u17b7\u1793\u1783\u17be\u1789\u179f\u17d2\u1793\u17b6\u178a\u17c3\u178a\u17be\u1798\u178a\u17c2\u179b\u17a2\u17b6\u1785\u1794\u17d2\u179a\u17be\u1794\u17b6\u1793\u17d4",
            "The margins leave no usable area on the target artboard.": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1782\u17c2\u1798\u1798\u17b7\u1793\u1791\u17bb\u1780\u1795\u17d2\u1791\u17c3\u1794\u17d2\u179a\u17be\u1794\u17d2\u179a\u17b6\u179f\u17cb\u179b\u17be\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u1782\u17c4\u179b\u178a\u17c5\u1791\u17c1\u17d4",
            "The source artwork could not be duplicated.": "\u1798\u17b7\u1793\u17a2\u17b6\u1785\u1785\u1798\u17d2\u179b\u1784\u179f\u17d2\u1793\u17b6\u178a\u17c3\u178a\u17be\u1798\u1794\u17b6\u1793\u17d4",
            "The source artwork has invalid dimensions.": "\u179f\u17d2\u1793\u17b6\u178a\u17c3\u178a\u17be\u1798\u1798\u17b6\u1793\u1791\u17c6\u17a0\u17c6\u1798\u17b7\u1793\u178f\u17d2\u179a\u17b9\u1798\u178f\u17d2\u179a\u17bc\u179c\u17d4",
            "The scaled artwork does not fit inside the artboard margins.": "\u179f\u17d2\u1793\u17b6\u178a\u17c3\u178a\u17c2\u179b\u1794\u17b6\u1793\u1794\u17d2\u178f\u17bc\u179a\u1791\u17c6\u17a0\u17c6\u1798\u17b7\u1793\u179f\u1798\u1780\u17d2\u1793\u17bb\u1784\u1782\u1798\u17d2\u179b\u17b6\u178f\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u17d4",
            "The scaled artwork does not fit inside the artboard bounds.": "\u179f\u17d2\u1793\u17b6\u178a\u17c3\u178a\u17c2\u179b\u1794\u17b6\u1793\u1794\u17d2\u178f\u17bc\u179a\u1791\u17c6\u17a0\u17c6\u1798\u17b7\u1793\u179f\u1798\u1780\u17d2\u1793\u17bb\u1784\u1796\u17d2\u179a\u17c6\u178a\u17c2\u1793\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u17d4",
            "The target artboard has invalid dimensions.": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u1782\u17c4\u179b\u178a\u17c5\u1798\u17b6\u1793\u1791\u17c6\u17a0\u17c6\u1798\u17b7\u1793\u178f\u17d2\u179a\u17b9\u1798\u178f\u17d2\u179a\u17bc\u179c\u17d4",
            "No copies fit within the selected layout.": "\u1782\u17d2\u1798\u17b6\u1793\u1785\u17d2\u1794\u17b6\u1794\u17cb\u1785\u1798\u17d2\u179b\u1784\u178e\u17b6\u179f\u1798\u1780\u17d2\u1793\u17bb\u1784\u1794\u17d2\u179b\u1784\u17cb\u178a\u17c2\u179b\u1794\u17b6\u1793\u1787\u17d2\u179a\u17be\u179f\u1791\u17c1\u17d4",
            "Creating repeat pattern...": "\u1780\u17c6\u1796\u17bb\u1784\u1794\u1784\u17d2\u1780\u17be\u178f\u179b\u17c6\u1793\u17b6\u17c6\u178a\u178a\u17c2\u179b\u17d7...",
            "Created": "\u1794\u17b6\u1793\u1794\u1784\u17d2\u1780\u17be\u178f",
            "repeated object(s) on layer": "\u179c\u178f\u17d2\u1790\u17bb\u178a\u178a\u17c2\u179b\u17d7\u179b\u17be\u179f\u17d2\u179a\u1791\u17b6\u1794\u17cb",
            "failed.": "\u1794\u17b6\u1793\u1794\u179a\u17b6\u1787\u17d0\u1799\u17d4",
            "Creating copy": "\u1780\u17c6\u1796\u17bb\u1784\u1794\u1784\u17d2\u1780\u17be\u178f\u1785\u17d2\u1794\u17b6\u1794\u17cb\u1785\u1798\u17d2\u179b\u1784", "of up to": "\u1780\u17d2\u1793\u17bb\u1784\u1785\u17c6\u178e\u17c4\u1798\u17a2\u178f\u17b7\u1794\u179a\u1798\u17b6",
            "Scale": "\u1798\u17b6\u178f\u17d2\u179a\u178a\u17d2\u178b\u17b6\u1793", "Tile width": "\u1791\u1791\u17b9\u1784\u1780\u17d2\u179a\u17a1\u17b6", "Tile height": "\u1780\u1798\u17d2\u1796\u179f\u17cb\u1780\u17d2\u179a\u17a1\u17b6",
            "Artboard gap": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a", "Artboard width": "\u1791\u1791\u17b9\u1784\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a",
            "Artboard height": "\u1780\u1798\u17d2\u1796\u179f\u17cb\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a", "Horizontal spacing": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1795\u17d2\u178a\u17c1\u1780",
            "Vertical spacing": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1794\u1789\u17d2\u1788\u179a", "Rows": "\u1787\u17bd\u179a\u178a\u17c1\u1780",
            "Horizontal margin": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1782\u17c2\u1798\u1795\u17d2\u178a\u17c1\u1780", "Vertical margin": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1782\u17c2\u1798\u1794\u1789\u17d2\u1788\u179a",
            "Stagger": "\u1780\u17b6\u179a\u179a\u17c6\u1780\u17b7\u179b", "Base rotation": "\u1798\u17bb\u17c6\u1794\u1784\u17d2\u179c\u17b7\u179b\u1782\u17c4\u179b",
            "Random rotation": "\u1780\u17b6\u179a\u1794\u1784\u17d2\u179c\u17b7\u179b\u1785\u17c3\u178a\u1793\u17d2\u1799", "Random scale": "\u1798\u17b6\u178f\u17d2\u179a\u178a\u17d2\u178b\u17b6\u1793\u1785\u17c3\u178a\u1793\u17d2\u1799",
            "Position jitter": "\u179a\u17c6\u1780\u17b7\u179b\u1791\u17b8\u178f\u17b6\u17c6\u1784", "Minimum opacity": "\u1797\u17b6\u1796\u179f\u17d2\u179a\u17a2\u17b6\u1794\u17cb\u17a2\u1794\u17d2\u1794\u1794\u179a\u1798\u17b6",
            "Random seed": "\u1782\u17d2\u179a\u17b6\u1794\u17cb\u179b\u17c1\u1781\u1785\u17c3\u178a\u1793\u17d2\u1799",

            "No Illustrator document is open.": "\u1798\u17b7\u1793\u1798\u17b6\u1793\u17af\u1780\u179f\u17b6\u179a Illustrator \u1780\u17c6\u1796\u17bb\u1784\u1794\u17be\u1780\u1791\u17c1\u17d4",
            "Open an Illustrator document before generating a QR code.": "\u179f\u17bc\u1798\u1794\u17be\u1780\u17af\u1780\u179f\u17b6\u179a Illustrator \u1798\u17bb\u1793\u1794\u1784\u17d2\u1780\u17be\u178f\u1780\u17bc\u178a QR\u17d4",
            "Open a document and select the artwork to nest.": "\u179f\u17bc\u1798\u1794\u17be\u1780\u17af\u1780\u179f\u17b6\u179a \u17a0\u17be\u1799\u1787\u17d2\u179a\u17be\u179f\u1782\u17c6\u1793\u17bc\u179a\u178a\u17c2\u179b\u178f\u17d2\u179a\u17bc\u179c\u179a\u17c0\u1794\u1785\u17c6\u17d4",
            "Select one or more objects to nest.": "\u179f\u17bc\u1798\u1787\u17d2\u179a\u17be\u179f\u179c\u178f\u17d2\u1790\u17bb\u1798\u17bd\u1799 \u17ac\u1785\u17d2\u179a\u17be\u1793\u178a\u17be\u1798\u17d2\u1794\u17b8\u179a\u17c0\u1794\u1785\u17c6\u17d4",
            "Open a document and select artwork before running Pathfinder.": "\u179f\u17bc\u1798\u1794\u17be\u1780\u17af\u1780\u179f\u17b6\u179a \u1793\u17b7\u1784\u1787\u17d2\u179a\u17be\u179f\u1782\u17c6\u1793\u17bc\u179a\u1798\u17bb\u1793\u178a\u17c6\u178e\u17be\u179a\u1780\u17b6\u179a Pathfinder\u17d4",
            "Select at least two objects before running Pathfinder.": "\u179f\u17bc\u1798\u1787\u17d2\u179a\u17be\u179f\u179c\u178f\u17d2\u1790\u17bb\u1799\u17c9\u17b6\u1784\u178f\u17b7\u1785\u1796\u17b8\u179a\u1798\u17bb\u1793\u178a\u17c6\u178e\u17be\u179a\u1780\u17b6\u179a Pathfinder\u17d4",
            "Open a document and select one template text frame.": "\u179f\u17bc\u1798\u1794\u17be\u1780\u17af\u1780\u179f\u17b6\u179a \u1793\u17b7\u1784\u1787\u17d2\u179a\u17be\u179f\u1794\u17d2\u179a\u17a2\u1794\u17cb\u17a2\u178f\u17d2\u1790\u1794\u1791\u1796\u17bb\u1798\u17d2\u1796\u1798\u17bd\u1799\u17d4",
            "Select one template text frame before running Sequential Numbering.": "\u179f\u17bc\u1798\u1787\u17d2\u179a\u17be\u179f\u1794\u17d2\u179a\u17a2\u1794\u17cb\u17a2\u178f\u17d2\u1790\u1794\u1791\u1796\u17bb\u1798\u17d2\u1796\u1798\u17bd\u1799\u1798\u17bb\u1793\u178a\u17c6\u178e\u17be\u179a\u1780\u17b6\u179a\u179b\u17c1\u1781\u179a\u17c0\u1784\u17d4",
            "Open a document and select artwork to dimension.": "\u179f\u17bc\u1798\u1794\u17be\u1780\u17af\u1780\u179f\u17b6\u179a \u1793\u17b7\u1784\u1787\u17d2\u179a\u17be\u179f\u1782\u17c6\u1793\u17bc\u179a\u178a\u17be\u1798\u17d2\u1794\u17b8\u179c\u17b6\u179f\u17cb\u1791\u17c6\u17a0\u17c6\u17d4",
            "Select one or more artwork objects to dimension.": "\u179f\u17bc\u1798\u1787\u17d2\u179a\u17be\u179f\u179c\u178f\u17d2\u1790\u17bb\u1782\u17c6\u1793\u17bc\u179a\u1798\u17bd\u1799 \u17ac\u1785\u17d2\u179a\u17be\u1793\u178a\u17be\u1798\u17d2\u1794\u17b8\u179c\u17b6\u179f\u17cb\u1791\u17c6\u17a0\u17c6\u17d4",
            "Auto-create additional sheets for unplaced items": "\u1794\u1784\u17d2\u1780\u17be\u178f\u179f\u1793\u17d2\u179b\u17b9\u1780\u1794\u1793\u17d2\u1790\u17c2\u1798\u178a\u17c4\u1799\u179f\u17d2\u179c\u17d0\u1799\u1794\u17d2\u179a\u179c\u178f\u17d2\u178f\u17b7\u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb\u179c\u178f\u17d2\u1790\u17bb\u1793\u17c5\u179f\u179b\u17cb",
            "Multi-sheet nesting": "\u1780\u17b6\u179a\u179a\u17c0\u1794\u1785\u17c6\u1785\u17d2\u179a\u17be\u1793\u179f\u1793\u17d2\u179b\u17b9\u1780",
            "Compound Path": "\u1795\u17d2\u179b\u17bc\u179c\u1795\u17d2\u179f\u17c6",
            "CutContour / Die-Line Generator": "\u1780\u1798\u17d2\u1798\u179c\u17b7\u1792\u17b8\u1794\u1784\u17d2\u1780\u17be\u178f\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb CutContour / DieLine",
            "CutContour": "\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb CutContour",
            "PerfCutContour": "\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb\u178a\u17b6\u1785\u17cb PerfCut",
            "Die-Line": "\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1796\u17bb\u1798\u17d2\u1796 DieLine",
            "Kiss-Cut": "\u1780\u17b6\u178f\u17cb\u1780\u17d2\u179a\u178a\u17b6\u179f\u179b\u17be (Kiss-Cut)",
            "Die-Cut": "\u1780\u17b6\u178f\u17cb\u178a\u17b6\u1785\u17cb\u1780\u17d2\u179a\u17c5 (Die-Cut)",
            "Cutline Shape": "\u1791\u1798\u17d2\u179a\u1784\u17cb\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb",
            "Tight Contour (Silhouette)": "\u178f\u17b6\u1798\u179a\u17b6\u1784\u1782\u17c2\u1798\u179f\u17d2\u1793\u17b6\u178a\u17c3 (Silhouette)",
            "Rounded Rectangle": "\u1785\u178f\u17bb\u1780\u17c4\u178e\u1780\u17c2\u1784\u1787\u17d2\u179a\u17bb\u1784\u1798\u17bc\u179b",
            "Rectangle": "\u1785\u178f\u17bb\u1780\u17c4\u178e\u1780\u17c2\u1784",
            "Circle / Ellipse": "\u179a\u1784\u17d2\u179c\u1784\u17cb\u1798\u17bc\u179b / \u1796\u1784\u1780\u17d2\u179a\u1796\u17be",
            "Capsule / Stadium": "\u1785\u178f\u17bb\u1780\u17c4\u178e\u1780\u17d2\u1794\u17b6\u179b\u1798\u17bc\u179b (Capsule)",
            "Custom Shape (Hexagon/Polygon)": "\u1796\u17a0\u17bb\u1780\u17c4\u178e (Polygon)",
            "Offset / Bleed": "\u1782\u1798\u17d2\u179b\u17b6\u178f\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb (Offset)",
            "Corner Radius": "\u1780\u17b6\u17c6\u1787\u17d2\u179a\u17bb\u1784\u1798\u17bc\u179b",
            "Spot Color Name:": "\u1788\u17d2\u1798\u17c4\u17c7\u1796\u178e\u17cc Spot Color:",
            "Stroke Weight:": "\u1780\u1798\u17d2\u179a\u17b6\u179f\u17cb\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb:",
            "Overprint Stroke": "Overprint \u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb (\u1780\u17bb\u17c6\u1787\u17c2\u17c8\u1786\u17d2\u179c\u17c0\u179b\u1796\u178e\u17cc)",
            "Keep Holes": "\u179a\u1780\u17d2\u179f\u17b6\u179a\u1793\u17d2\u1792\u17c4\u17c7\u1781\u17b6\u1784\u1780\u17d2\u1793\u17bb\u1784",
            "Remove Small Holes": "\u179b\u17bb\u1794\u179a\u1793\u17d2\u1792\u17c4\u17c7\u178f\u17bc\u1785\u17d7",
            "Remove All Holes": "\u179b\u17bb\u1794\u179a\u1793\u17d2\u1792\u17c4\u17c7\u1791\u17b6\u17c6\u1784\u17a2\u179f\u17cb",
            "Optimize Cut Path": "\u179f\u1798\u17d2\u17a2\u17b6\u178f\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb (Optimize)",
            "Registration Marks": "\u179f\u1789\u17d2\u1789\u17b6\u179f\u1798\u17d2\u1782\u17b6\u179b\u17cb\u1780\u17b6\u178f\u17cb (Registration Marks)",
            "Simple Mode": "\u1798\u17c9\u17bc\u178a\u1792\u1798\u17d2\u1798\u178f\u17b6 (Simple)",
            "Pro Mode": "\u1798\u17c9\u17bc\u178a\u1787\u17c6\u1793\u17b6\u1789 (Pro)",
            "Ready for Production": "\u179a\u17bd\u1785\u179a\u17b6\u179b\u17cb\u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb\u1780\u17b6\u179a\u1795\u179b\u17b7\u178f",
            "Generate CutContour": "\u1794\u1784\u17d2\u1780\u17be\u178f\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb",
            "Select artwork before running CutContour Generator.": "\u179f\u17bc\u1798\u1787\u17d2\u179a\u17be\u179f\u1782\u17c6\u1793\u17bc\u179a\u179f\u17d2\u1793\u17b6\u178a\u17c3\u1798\u17bb\u1793\u1794\u1784\u17d2\u1780\u17be\u178f\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb\u17d4",
            "CutContour generated successfully.": "\u1794\u17b6\u1793\u1794\u1784\u17d2\u1780\u17be\u178f\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u1780\u17b6\u178f\u17cb\u178a\u17c4\u1799\u1787\u17c4\u1782\u1787\u17d0\u1799\u17d4",
            "New guide layout": "\u1794\u17d2\u179b\u1784\u17cb\u1794\u1793\u17d2\u1791\u17b6\u178f\u17cb\u178e\u17c2\u1793\u17b6\u17c6\u1790\u17d2\u1798\u17b8 (New Guide Layout)",
            "Preset:": "\u1782\u17c6\u179a\u17bc\u1780\u17c6\u178e\u178f\u17cb\u17d6",
            "Target:": "\u1782\u17c4\u179b\u178a\u17c5\u17d6",
            "Canvas": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1780\u17b6\u179a\u1784\u17b6\u179a (Canvas)",
            "Active Artboard": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u179f\u1780\u1798\u17d2\u1798",
            "All Artboards": "\u1795\u17d2\u1791\u17b6\u17c6\u1784\u1782\u17c6\u1793\u17bc\u179a\u1791\u17b6\u17c6\u1784\u17a2\u179f\u17cb",
            "Selected Artwork": "\u1782\u17c6\u1793\u17bc\u179a\u178a\u17c2\u179b\u1794\u17b6\u1793\u1787\u17d2\u179a\u17be\u179f",
            "Color": "\u1796\u178e\u17cc",
            "Columns": "\u1787\u17bd\u179a\u1788\u179a",
            "Rows": "\u1787\u17bd\u179a\u178a\u17c1\u1780",
