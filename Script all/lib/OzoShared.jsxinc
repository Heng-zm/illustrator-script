            "Black": "\u1781\u17d2\u1798\u17c5", "White": "\u179f", "Blue": "\u1781\u17c0\u179c",
            "No icons selected for import.": "\u1798\u17b7\u1793\u1798\u17b6\u1793\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u178a\u17c2\u179b\u1794\u17b6\u1793\u1787\u17d2\u179a\u17be\u179f\u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb\u1793\u17b6\u17c6\u1785\u17bc\u179b\u1791\u17c1\u17d4",
            "Search Iconify": "\u179f\u17d2\u179c\u17c2\u1784\u179a\u1780 Iconify", "Search": "\u179f\u17d2\u179c\u17c2\u1784\u179a\u1780", "Icon set:": "\u179f\u17c6\u178e\u17bb\u17c6\u179a\u17bc\u1794\u178f\u17c6\u178e\u17b6\u1784\u17d6",
