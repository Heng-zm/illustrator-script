# KHQRPay API Key
# Use kp_live_... for real payments (money goes straight to your ABA account)
# Use kp_test_... for simulated testing
KHQRPAY_API_KEY=kp_live_your_api_key_here

# KHQRPay Webhook Signing Secret (starts with whsec_)
# Obtained from your KHQRPay dashboard webhook configuration
KHQRPAY_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Server Port (default: 3000)
PORT=3000

# Environment mode: 'production' or 'development'
# In production, test events (livemode: false or test: true) are safely acknowledged without fulfilling orders.
NODE_ENV=development
